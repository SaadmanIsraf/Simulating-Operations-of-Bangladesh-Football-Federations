<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="700.0"
            prefWidth="1100.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.summer26.section1.group10.simulatingoperationsofbangladeshfootballfederation.turjo.controller.federation_manageteamrankingController">

    <children>

        <Label layoutX="400.0"
               layoutY="20.0"
               text="Manage Team Rankings"
               style="-fx-font-size:24px; -fx-font-weight:bold;"/>

        <VBox layoutX="20.0"
              layoutY="60.0"
              prefWidth="320.0"
              spacing="10">

            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>

            <Label text="Team Name"/>
            <TextField fx:id="teamNameTF"
                       promptText="Enter Team Name"/>

            <Label text="Wins"/>
            <TextField fx:id="winsTF"/>

            <Label text="Draws"/>
            <TextField fx:id="drawsTF"/>

            <Label text="Losses"/>
            <TextField fx:id="lossesTF"/>

            <Label text="Search Team"/>
            <TextField fx:id="searchTF"
                       promptText="Search by Team Name"/>

            <HBox spacing="10">

                <Button text="Search"
                        prefWidth="80"
                        onAction="#searchButtonOnAction"/>

                <Button text="Add Team"
                        prefWidth="90"
                        onAction="#addButtonOnAction"/>

            </HBox>

            <HBox spacing="10">

                <Button text="Update"
                        prefWidth="90"
                        onAction="#updateButtonOnAction"/>

                <Button text="Clear"
                        prefWidth="90"
                        onAction="#clearButtonOnAction"/>

                <Button text="Back"
                        prefWidth="90"
                        onAction="#backButtonOnAction"/>

            </HBox>

        </VBox>

        <TableView fx:id="rankingTable"
                   layoutX="360.0"
                   layoutY="60.0"
                   prefHeight="610.0"
                   prefWidth="720.0">

            <columns>

                <TableColumn fx:id="teamNameCol"
                             text="Team Name"
                             prefWidth="220"/>

                <TableColumn fx:id="winsCol"
                             text="Wins"
                             prefWidth="90"/>

                <TableColumn fx:id="drawsCol"
                             text="Draws"
                             prefWidth="90"/>

                <TableColumn fx:id="lossesCol"
                             text="Losses"
                             prefWidth="90"/>

                <TableColumn fx:id="pointsCol"
                             text="Points"
                             prefWidth="90"/>

            </columns>

        </TableView>

    </children>

</AnchorPane>