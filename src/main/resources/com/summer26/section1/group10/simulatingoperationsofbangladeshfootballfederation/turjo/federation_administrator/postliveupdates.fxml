<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="700.0"
            prefWidth="1100.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.summer26.section1.group10.simulatingoperationsofbangladeshfootballfederation.turjo.controller.federation_postliveupdateController">

    <children>

        <Label layoutX="420.0"
               layoutY="20.0"
               text="Post Live Update"
               style="-fx-font-size:24px; -fx-font-weight:bold;"/>

        <VBox layoutX="20.0"
              layoutY="60.0"
              prefWidth="320.0"
              spacing="10">

            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>

            <Label text="Match ID"/>
            <TextField fx:id="matchIdTF"
                       promptText="Enter Match ID"/>

            <Label text="Minute"/>
            <TextField fx:id="minuteTF"
                       promptText="e.g. 45+2"/>

            <Label text="Event Type"/>
            <ComboBox fx:id="eventTypeCB"/>

            <Label text="Player Name"/>
            <TextField fx:id="playerNameTF"
                       promptText="Enter Player Name"/>

            <Label text="Home Score"/>
            <TextField fx:id="homeScoreTF"/>

            <Label text="Away Score"/>
            <TextField fx:id="awayScoreTF"/>

            <Label text="Update Details"/>
            <TextArea fx:id="detailsTA"
                      prefHeight="120"
                      wrapText="true"
                      promptText="Describe the live event..."/>

            <HBox spacing="10">

                <Button text="Post"
                        prefWidth="90"
                        onAction="#postButtonOnAction"/>

                <Button text="Clear"
                        prefWidth="90"
                        onAction="#clearButtonOnAction"/>

                <Button text="Back"
                        prefWidth="90"
                        onAction="#backButtonOnAction"/>

            </HBox>

        </VBox>

        <TableView fx:id="liveUpdateTable"
                   layoutX="360.0"
                   layoutY="60.0"
                   prefHeight="610.0"
                   prefWidth="720.0">

            <columns>

                <TableColumn fx:id="matchIdCol"
                             text="Match ID"
                             prefWidth="90"/>

                <TableColumn fx:id="minuteCol"
                             text="Minute"
                             prefWidth="80"/>

                <TableColumn fx:id="eventTypeCol"
                             text="Event"
                             prefWidth="130"/>

                <TableColumn fx:id="playerNameCol"
                             text="Player"
                             prefWidth="150"/>

                <TableColumn fx:id="scoreCol"
                             text="Score"
                             prefWidth="100"/>

                <TableColumn fx:id="detailsCol"
                             text="Details"
                             prefWidth="170"/>

            </columns>

        </TableView>

    </children>

</AnchorPane>