<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="460.0" prefWidth="600.0" style="-fx-background-color: E6E8AC;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.summer26.section1.group10.simulatingoperationsofbangladeshfootballfederation.Ruba.BookingController">
    <children>
        <Label layoutX="150.0" layoutY="20.0" text="Cancel / Refund Booking">
            <font>
                <Font size="22.0" />
            </font>
        </Label>

        <Label layoutX="40.0" layoutY="80.0" text="Booking ID :" />
        <TextField fx:id="bookingIdField" layoutX="140.0" layoutY="76.0" prefWidth="180.0" promptText="e.g. BK001" />
        <Button layoutX="340.0" layoutY="76.0" mnemonicParsing="false" onAction="#searchBooking" text="Search" />

        <Label layoutX="40.0" layoutY="140.0" text="Match :" />
        <Label fx:id="matchLabel" layoutX="140.0" layoutY="140.0" prefWidth="400.0" text="-" />

        <Label layoutX="40.0" layoutY="170.0" text="Customer :" />
        <Label fx:id="customerLabel" layoutX="140.0" layoutY="170.0" prefWidth="400.0" text="-" />

        <Label layoutX="40.0" layoutY="200.0" text="Quantity :" />
        <Label fx:id="quantityLabel" layoutX="140.0" layoutY="200.0" text="-" />

        <Label layoutX="40.0" layoutY="230.0" text="Status :" />
        <Label fx:id="statusValueLabel" layoutX="140.0" layoutY="230.0" text="-" />

        <Button layoutX="140.0" layoutY="280.0" mnemonicParsing="false" onAction="#cancelBooking" text="Cancel Booking" />
        <Button layoutX="300.0" layoutY="280.0" mnemonicParsing="false" onAction="#refundBooking" text="Refund Booking" />

        <Label fx:id="statusLabel" layoutX="40.0" layoutY="330.0" prefWidth="520.0" text="" />

        <Button layoutX="40.0" layoutY="400.0" mnemonicParsing="false" onAction="#backBtnOnAction" text="Back" />
    </children>
</AnchorPane>