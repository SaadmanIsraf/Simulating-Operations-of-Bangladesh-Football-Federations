<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<AnchorPane prefHeight="600.0" prefWidth="800.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.summer26.section1.group10.simulatingoperationsofbangladeshfootballfederation.turjo.controller.matchofficials_UpdateMatchStatusController">

    <children>
        <VBox spacing="15.0" alignment="TOP_CENTER"
              AnchorPane.topAnchor="20.0"
              AnchorPane.leftAnchor="30.0"
              AnchorPane.rightAnchor="30.0"
              AnchorPane.bottomAnchor="20.0">

            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <Label text="Update Match Status"
                   style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

            <GridPane hgap="15" vgap="15">

                <Label text="Match ID:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="matchIdTextField"
                           promptText="Enter Match ID"
                           GridPane.rowIndex="0"
                           GridPane.columnIndex="1"/>

                <Button text="Load Match"
                        fx:id="loadButton"
                        onAction="#loadMatch"
                        GridPane.rowIndex="0"
                        GridPane.columnIndex="2"/>

                <Label text="Home Team:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="homeTeamTextField"
                           editable="false"
                           GridPane.rowIndex="1"
                           GridPane.columnIndex="1"/>

                <Label text="Away Team:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <TextField fx:id="awayTeamTextField"
                           editable="false"
                           GridPane.rowIndex="2"
                           GridPane.columnIndex="1"/>

                <Label text="Home Score:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <Spinner fx:id="homeScoreSpinner"
                         GridPane.rowIndex="3"
                         GridPane.columnIndex="1"/>

                <Label text="Away Score:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                <Spinner fx:id="awayScoreSpinner"
                         GridPane.rowIndex="4"
                         GridPane.columnIndex="1"/>

                <Label text="Status:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                <ComboBox fx:id="statusComboBox"
                          GridPane.rowIndex="5"
                          GridPane.columnIndex="1">
                    <items>
                        <FXCollections fx:factory="observableArrayList">
                            <String fx:value="Scheduled"/>
                            <String fx:value="First Half"/>
                            <String fx:value="Half Time"/>
                            <String fx:value="Second Half"/>
                            <String fx:value="Extra Time"/>
                            <String fx:value="Penalty Shootout"/>
                            <String fx:value="Finished"/>
                            <String fx:value="Postponed"/>
                            <String fx:value="Cancelled"/>
                        </FXCollections>
                    </items>
                </ComboBox>

                <Label text="Venue:" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                <TextField fx:id="venueTextField"
                           GridPane.rowIndex="6"
                           GridPane.columnIndex="1"/>

                <Label text="Remarks:" GridPane.rowIndex="7" GridPane.columnIndex="0"/>
                <TextArea fx:id="remarksTextArea"
                          prefRowCount="3"
                          GridPane.rowIndex="7"
                          GridPane.columnIndex="1"/>

            </GridPane>

            <HBox spacing="20" alignment="CENTER">
                <Button text="Update Match"
                        fx:id="updateButton"
                        onAction="#updateMatch"/>

                <Button text="Clear"
                        fx:id="clearButton"
                        onAction="#clearFields"/>
            </HBox>

            <Label fx:id="statusLabel"
                   style="-fx-text-fill: green; -fx-font-weight: bold;"/>

        </VBox>
    </children>

</AnchorPane>