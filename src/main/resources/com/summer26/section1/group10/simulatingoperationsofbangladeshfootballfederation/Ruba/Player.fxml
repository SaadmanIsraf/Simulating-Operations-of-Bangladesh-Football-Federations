<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="498.0" prefWidth="660.0" style="-fx-background-color: E6E8AC;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.summer26.section1.group10.simulatingoperationsofbangladeshfootballfederation.Ruba.PlayerController">

    <Label layoutX="211.0" layoutY="21.0" text="Player Statistics">
        <font>
            <Font size="24.0" />
        </font>
    </Label>

    <Label layoutX="44.0" layoutY="89.0" text="Player :" />

    <ComboBox fx:id="playerComboBox" layoutX="106.0" layoutY="85.0" prefWidth="150.0" />

    <Button layoutX="417.0" layoutY="85.0" mnemonicParsing="false" onAction="#searchPlayer" text="Search" />

    <TableView fx:id="playerTable" layoutX="93.0" layoutY="187.0" prefHeight="200.0" prefWidth="471.0">
        <columns>
            <TableColumn fx:id="playerNameColumn" prefWidth="135.0" text="Player Name" />
            <TableColumn fx:id="teamColumn" prefWidth="112.0" text="Team" />
            <TableColumn fx:id="positionColumn" prefWidth="112.0" text="Position" />
            <TableColumn fx:id="fitnessColumn" prefWidth="112.0" text="Fitness Status" />
        </columns>
    </TableView>
    <Button layoutX="44.0" layoutY="437.0" mnemonicParsing="false" onAction="#backBtnOnAction" text="Back" />

</AnchorPane>