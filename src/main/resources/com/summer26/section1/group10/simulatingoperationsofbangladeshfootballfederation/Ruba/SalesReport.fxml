<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="560.0" prefWidth="700.0" style="-fx-background-color: E6E8AC;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.summer26.section1.group10.simulatingoperationsofbangladeshfootballfederation.Ruba.SalesReportController">
    <children>
        <Label layoutX="220.0" layoutY="20.0" text="Ticket Sales Report">
            <font>
                <Font size="24.0" />
            </font>
        </Label>

        <Label layoutX="40.0" layoutY="80.0" text="Start Date :" />
        <DatePicker fx:id="startDatePicker" layoutX="140.0" layoutY="76.0" prefWidth="150.0" />

        <Label layoutX="320.0" layoutY="80.0" text="End Date :" />
        <DatePicker fx:id="endDatePicker" layoutX="410.0" layoutY="76.0" prefWidth="150.0" />

        <Button layoutX="580.0" layoutY="76.0" mnemonicParsing="false" onAction="#generateReport" text="Generate" />

        <Button layoutX="140.0" layoutY="120.0" mnemonicParsing="false" onAction="#showTodaySummary" text="Today's Summary" />
        <Button layoutX="290.0" layoutY="120.0" mnemonicParsing="false" onAction="#showWeekSummary" text="This Week's Summary" />

        <Label fx:id="statusLabel" layoutX="40.0" layoutY="160.0" prefWidth="620.0" text="" />

        <TableView fx:id="saleTable" layoutX="40.0" layoutY="195.0" prefHeight="230.0" prefWidth="620.0">
            <columns>
                <TableColumn fx:id="dateColumn" prefWidth="120.0" text="Date" />
                <TableColumn fx:id="matchColumn" prefWidth="260.0" text="Match" />
                <TableColumn fx:id="ticketsSoldColumn" prefWidth="120.0" text="Tickets Sold" />
                <TableColumn fx:id="revenueColumn" prefWidth="120.0" text="Revenue" />
            </columns>
        </TableView>

        <Label fx:id="totalTicketsLabel" layoutX="40.0" layoutY="440.0" text="" />
        <Label fx:id="totalRevenueLabel" layoutX="40.0" layoutY="465.0" text="" />

        <Button layoutX="40.0" layoutY="510.0" mnemonicParsing="false" onAction="#backBtnOnAction" text="Back" />
    </children>
</AnchorPane>