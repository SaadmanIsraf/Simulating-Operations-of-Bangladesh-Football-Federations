<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="700.0"
            prefWidth="1050.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.summer26.section1.group10.simulatingoperationsofbangladeshfootballfederation.turjo.controller.federation_uploadmatchhighlightsController">

    <children>

        <Label layoutX="370.0"
               layoutY="20.0"
               text="Upload Match Highlights"
               style="-fx-font-size:24px; -fx-font-weight:bold;"/>

        <VBox layoutX="20.0"
              layoutY="60.0"
              prefWidth="320.0"
              spacing="10">

            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>

            <Label text="Match ID"/>
            <TextField fx:id="matchIdTF"
                       promptText="Enter Match ID"/>

            <Label text="Highlight Title"/>
            <TextField fx:id="titleTF"
                       promptText="Highlight Title"/>

            <Label text="Video Link"/>
            <TextField fx:id="videoLinkTF"
                       promptText="Paste Video URL"/>

            <Label text="Duration"/>
            <TextField fx:id="durationTF"
                       promptText="Example: 03:45"/>

            <Label text="Highlight Type"/>
            <ComboBox fx:id="highlightTypeCB"/>

            <Label text="Publish Status"/>
            <ComboBox fx:id="publishStatusCB"/>

            <Label text="Description"/>
            <TextArea fx:id="descriptionTA"
                      prefHeight="120"
                      wrapText="true"
                      promptText="Enter highlight description..."/>

            <HBox spacing="10">

                <Button text="Upload"
                        prefWidth="90"
                        onAction="#uploadButtonOnAction"/>

                <Button text="Clear"
                        prefWidth="90"
                        onAction="#clearButtonOnAction"/>

                <Button text="Back"
                        prefWidth="90"
                        onAction="#backButtonOnAction"/>

            </HBox>

        </VBox>

        <TableView fx:id="highlightTable"
                   layoutX="360.0"
                   layoutY="60.0"
                   prefHeight="610.0"
                   prefWidth="670.0">

            <columns>

                <TableColumn fx:id="matchIdCol"
                             text="Match ID"
                             prefWidth="90"/>

                <TableColumn fx:id="titleCol"
                             text="Title"
                             prefWidth="180"/>

                <TableColumn fx:id="typeCol"
                             text="Type"
                             prefWidth="120"/>

                <TableColumn fx:id="durationCol"
                             text="Duration"
                             prefWidth="90"/>

                <TableColumn fx:id="statusCol"
                             text="Status"
                             prefWidth="120"/>

                <TableColumn fx:id="videoLinkCol"
                             text="Video Link"
                             prefWidth="170"/>

            </columns>

        </TableView>

    </children>

</AnchorPane>