<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="550.0"
            prefWidth="850.0"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.summer26.section1.group10.simulatingoperationsofbangladeshfootballfederation.turjo.controller.matchofficial_recordfoulscardsController">


    <Label layoutX="260.0"
           layoutY="30.0"
           text="Record Fouls and Cards">

        <font>
            <Font size="24"/>
        </font>

    </Label>



    <!-- Match -->

    <Label layoutX="60.0"
           layoutY="100.0"
           text="Match"/>

    <ComboBox fx:id="matchCB"
              layoutX="60.0"
              layoutY="125.0"
              prefWidth="220"
              promptText="Select Match"/>



    <!-- Player Name -->

    <Label layoutX="350.0"
           layoutY="100.0"
           text="Player Name"/>

    <TextField fx:id="playerNameTF"
               layoutX="350.0"
               layoutY="125.0"
               prefWidth="220"
               promptText="Enter Player Name"/>



    <!-- Minute -->

    <Label layoutX="640.0"
           layoutY="100.0"
           text="Minute"/>

    <TextField fx:id="minuteTF"
               layoutX="640.0"
               layoutY="125.0"
               prefWidth="120"
               promptText="Minute"/>




    <!-- Event Type -->

    <Label layoutX="60.0"
           layoutY="220.0"
           text="Event Type"/>

    <ComboBox fx:id="eventTypeCB"
              layoutX="60.0"
              layoutY="245.0"
              prefWidth="220"
              promptText="Foul / Card"/>




    <!-- Card Type -->

    <Label layoutX="350.0"
           layoutY="220.0"
           text="Card Type"/>

    <ComboBox fx:id="cardTypeCB"
              layoutX="350.0"
              layoutY="245.0"
              prefWidth="220"
              promptText="Yellow / Red"/>




    <!-- Foul Type -->

    <Label layoutX="640.0"
           layoutY="220.0"
           text="Foul Type"/>

    <TextField fx:id="foulTypeTF"
               layoutX="640.0"
               layoutY="245.0"
               prefWidth="150"
               promptText="Enter Foul"/>




    <!-- Description -->

    <Label layoutX="60.0"
           layoutY="330.0"
           text="Official Notes"/>

    <TextArea fx:id="noteTA"
              layoutX="60.0"
              layoutY="355.0"
              prefWidth="730"
              prefHeight="80"
              promptText="Write incident details"/>




    <!-- Buttons -->

    <Button layoutX="150.0"
            layoutY="480.0"
            prefWidth="150"
            text="Save Record"
            onAction="#saveRecordOA"/>


    <Button layoutX="350.0"
            layoutY="480.0"
            prefWidth="150"
            text="Clear"
            onAction="#clearOA"/>


    <Button layoutX="550.0"
            layoutY="480.0"
            prefWidth="120"
            text="Back"
            onAction="#backOA"/>


</AnchorPane>