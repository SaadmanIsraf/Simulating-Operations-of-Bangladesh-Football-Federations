<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="560.0"
            prefWidth="760.0"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.summer26.section1.group10.simulatingoperationsofbangladeshfootballfederation.Arman.player_controller.join_team_request_controller">

    <top>
        <HBox alignment="CENTER"
              prefHeight="81.0"
              style="-fx-background-color: #42AD60;"
              BorderPane.alignment="CENTER">

            <Label text="Request to Join a Team"
                   textFill="WHITE">

                <font>
                    <Font name="Times New Roman Bold" size="20.0"/>
                </font>

            </Label>

        </HBox>
    </top>

    <center>
        <VBox alignment="TOP_CENTER"
              spacing="18.0"
              style="-fx-background-color: #F4F7F5;">

            <padding>
                <Insets top="25.0"
                        right="35.0"
                        bottom="25.0"
                        left="35.0"/>
            </padding>

            <Label text="Search for a Team"
                   textFill="#2F5638">

                <font>
                    <Font name="Times New Roman Bold" size="17.0"/>
                </font>

            </Label>

            <GridPane alignment="CENTER"
                      hgap="15.0"
                      vgap="12.0">

                <Label text="Team ID or Team Name:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="0">

                    <font>
                        <Font name="Times New Roman Bold" size="14.0"/>
                    </font>

                </Label>

                <TextField fx:id="team_search_textfield"
                           prefWidth="280.0"
                           promptText="Enter team ID or team name"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="0"/>

                <Button mnemonicParsing="false"
                        onAction="#search_team_button_on_action"
                        prefWidth="90.0"
                        style="-fx-background-color: #42AD60;
                               -fx-text-fill: white;
                               -fx-font-weight: bold;"
                        text="Search"
                        GridPane.columnIndex="2"
                        GridPane.rowIndex="0"/>

            </GridPane>

            <TableView fx:id="team_table"
                       prefHeight="250.0"
                       prefWidth="680.0">

                <columns>

                    <TableColumn fx:id="team_id_column"
                                 prefWidth="110.0"
                                 text="Team ID"/>

                    <TableColumn fx:id="team_name_column"
                                 prefWidth="210.0"
                                 text="Team Name"/>

                    <TableColumn fx:id="coach_name_column"
                                 prefWidth="190.0"
                                 text="Coach"/>

                    <TableColumn fx:id="team_status_column"
                                 prefWidth="165.0"
                                 text="Team Status"/>

                </columns>

            </TableView>

            <Label fx:id="selected_team_label"
                   alignment="CENTER"
                   prefWidth="650.0"
                   text="No team selected">

                <font>
                    <Font name="Times New Roman Bold" size="14.0"/>
                </font>

            </Label>

            <Label fx:id="information_label"
                   alignment="CENTER"
                   prefHeight="28.0"
                   prefWidth="650.0"
                   textFill="#C0392B">

                <font>
                    <Font name="Times New Roman Bold" size="13.0"/>
                </font>

            </Label>

            <HBox alignment="CENTER"
                  spacing="350.0">

                <Button mnemonicParsing="false"
                        onAction="#back_button_on_action"
                        prefWidth="90.0"
                        text="← Back"/>

                <Button fx:id="send_request_button"
                        disable="true"
                        mnemonicParsing="false"
                        onAction="#send_request_button_on_action"
                        prefWidth="140.0"
                        style="-fx-background-color: #42AD60;
                               -fx-text-fill: white;
                               -fx-font-weight: bold;"
                        text="Send Join Request"/>

            </HBox>

        </VBox>
    </center>

</BorderPane>