<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="700.0"
            prefWidth="1150.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.summer26.section1.group10.simulatingoperationsofbangladeshfootballfederation.turjo.controller.federation_managematchesController">

    <children>

        <Label layoutX="430.0"
               layoutY="20.0"
               text="Manage Matches"
               style="-fx-font-size:24px; -fx-font-weight:bold;"/>

        <VBox layoutX="20.0"
              layoutY="60.0"
              prefWidth="320.0"
              spacing="10">

            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>

            <Label text="Match ID"/>
            <TextField fx:id="matchIdTF"/>

            <Label text="Competition"/>
            <ComboBox fx:id="competitionCB"/>

            <Label text="Home Team"/>
            <TextField fx:id="homeTeamTF"/>

            <Label text="Away Team"/>
            <TextField fx:id="awayTeamTF"/>

            <Label text="Match Date"/>
            <DatePicker fx:id="matchDateDP"/>

            <Label text="Match Time"/>
            <TextField fx:id="matchTimeTF"/>

            <Label text="Stadium"/>
            <TextField fx:id="stadiumTF"/>

            <Label text="Match Status"/>
            <ComboBox fx:id="statusCB"/>

            <HBox spacing="10">

                <Button text="Add Match"
                        prefWidth="100"
                        onAction="#addButtonOnAction"/>

                <Button text="Clear"
                        prefWidth="80"
                        onAction="#clearButtonOnAction"/>

                <Button text="Back"
                        prefWidth="80"
                        onAction="#backButtonOnAction"/>

            </HBox>

        </VBox>

        <TableView fx:id="matchTable"
                   layoutX="360.0"
                   layoutY="60.0"
                   prefHeight="610.0"
                   prefWidth="760.0">

            <columns>

                <TableColumn fx:id="matchIdCol"
                             text="Match ID"
                             prefWidth="90"/>

                <TableColumn fx:id="competitionCol"
                             text="Competition"
                             prefWidth="120"/>

                <TableColumn fx:id="homeTeamCol"
                             text="Home Team"
                             prefWidth="120"/>

                <TableColumn fx:id="awayTeamCol"
                             text="Away Team"
                             prefWidth="120"/>

                <TableColumn fx:id="dateCol"
                             text="Date"
                             prefWidth="100"/>

                <TableColumn fx:id="timeCol"
                             text="Time"
                             prefWidth="80"/>

                <TableColumn fx:id="stadiumCol"
                             text="Stadium"
                             prefWidth="140"/>

                <TableColumn fx:id="statusCol"
                             text="Status"
                             prefWidth="100"/>

            </columns>

        </TableView>

    </children>

</AnchorPane>