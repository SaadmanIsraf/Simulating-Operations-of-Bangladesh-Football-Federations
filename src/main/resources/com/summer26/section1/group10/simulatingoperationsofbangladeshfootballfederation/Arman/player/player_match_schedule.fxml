<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="516.0"
            prefWidth="720.0"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.summer26.section1.group10.simulatingoperationsofbangladeshfootballfederation.Arman.player_controller.player_match_schedule_controller">

    <top>
        <HBox alignment="CENTER"
              prefHeight="81.0"
              style="-fx-background-color: #42AD60;"
              BorderPane.alignment="CENTER">

            <Label text="Player Match Schedule"
                   textFill="WHITE">

                <font>
                    <Font name="Times New Roman Bold" size="20.0"/>
                </font>

            </Label>

        </HBox>
    </top>

    <center>
        <VBox alignment="TOP_CENTER"
              spacing="18.0"
              style="-fx-background-color: #F4F7F5;">

            <padding>
                <Insets top="25.0"
                        right="30.0"
                        bottom="25.0"
                        left="30.0"/>
            </padding>

            <Label text="Upcoming Matches"
                   textFill="#2F5638">

                <font>
                    <Font name="Times New Roman Bold" size="17.0"/>
                </font>

            </Label>

            <TableView fx:id="match_schedule_table"
                       prefHeight="290.0"
                       prefWidth="660.0">

                <columns>

                    <TableColumn fx:id="opponent_column"
                                 prefWidth="145.0"
                                 text="Opponent"/>

                    <TableColumn fx:id="match_date_column"
                                 prefWidth="110.0"
                                 text="Match Date"/>

                    <TableColumn fx:id="match_time_column"
                                 prefWidth="100.0"
                                 text="Match Time"/>

                    <TableColumn fx:id="venue_column"
                                 prefWidth="145.0"
                                 text="Venue"/>

                    <TableColumn fx:id="tournament_column"
                                 prefWidth="155.0"
                                 text="Tournament"/>

                </columns>

            </TableView>

            <Label fx:id="information_label"
                   alignment="CENTER"
                   prefHeight="28.0"
                   prefWidth="620.0"
                   textFill="#C0392B">

                <font>
                    <Font name="Times New Roman Bold" size="13.0"/>
                </font>

            </Label>

            <HBox alignment="CENTER"
                  spacing="380.0">

                <Button mnemonicParsing="false"
                        onAction="#back_button_on_action"
                        prefWidth="90.0"
                        text="← Back"/>

                <Button mnemonicParsing="false"
                        onAction="#refresh_button_on_action"
                        prefWidth="100.0"
                        style="-fx-background-color: #42AD60;
                               -fx-text-fill: white;
                               -fx-font-weight: bold;"
                        text="Refresh"/>

            </HBox>

        </VBox>
    </center>

</BorderPane>