<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="620.0"
            prefWidth="820.0"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.summer26.section1.group10.simulatingoperationsofbangladeshfootballfederation.Arman.player_controller.tournament_rules_controller">

    <top>
        <HBox alignment="CENTER"
              prefHeight="81.0"
              style="-fx-background-color: #42AD60;"
              BorderPane.alignment="CENTER">

            <Label text="Tournament Rules"
                   textFill="WHITE">

                <font>
                    <Font name="Times New Roman Bold" size="20.0"/>
                </font>

            </Label>
        </HBox>
    </top>

    <center>
        <VBox alignment="TOP_CENTER"
              spacing="14.0"
              style="-fx-background-color: #F4F7F5;">

            <padding>
                <Insets bottom="22.0"
                        left="35.0"
                        right="35.0"
                        top="22.0"/>
            </padding>

            <Label text="View Tournament Information"
                   textFill="#2F5638">

                <font>
                    <Font name="Times New Roman Bold" size="17.0"/>
                </font>

            </Label>

            <HBox alignment="CENTER"
                  spacing="15.0">

                <Label text="Select Tournament:">

                    <font>
                        <Font name="Times New Roman Bold" size="14.0"/>
                    </font>

                </Label>

                <ComboBox fx:id="tournament_combobox"
                          onAction="#tournament_combobox_on_action"
                          prefWidth="270.0"
                          promptText="Choose a tournament"/>

            </HBox>

            <GridPane alignment="CENTER"
                      hgap="18.0"
                      vgap="12.0">

                <Label text="Tournament Rules:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="0">

                    <font>
                        <Font name="Times New Roman Bold" size="13.0"/>
                    </font>

                </Label>

                <TextArea fx:id="tournament_rules_textarea"
                          editable="false"
                          prefHeight="75.0"
                          prefWidth="500.0"
                          wrapText="true"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="0"/>

                <Label text="Eligibility Criteria:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="1">

                    <font>
                        <Font name="Times New Roman Bold" size="13.0"/>
                    </font>

                </Label>

                <TextArea fx:id="eligibility_criteria_textarea"
                          editable="false"
                          prefHeight="75.0"
                          prefWidth="500.0"
                          wrapText="true"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="1"/>

                <Label text="Code of Conduct:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="2">

                    <font>
                        <Font name="Times New Roman Bold" size="13.0"/>
                    </font>

                </Label>

                <TextArea fx:id="code_of_conduct_textarea"
                          editable="false"
                          prefHeight="75.0"
                          prefWidth="500.0"
                          wrapText="true"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="2"/>

                <Label text="Match Regulations:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="3">

                    <font>
                        <Font name="Times New Roman Bold" size="13.0"/>
                    </font>

                </Label>

                <TextArea fx:id="match_regulations_textarea"
                          editable="false"
                          prefHeight="75.0"
                          prefWidth="500.0"
                          wrapText="true"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="3"/>

                <Label text="Disciplinary Guidelines:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="4">

                    <font>
                        <Font name="Times New Roman Bold" size="13.0"/>
                    </font>

                </Label>

                <TextArea fx:id="disciplinary_guidelines_textarea"
                          editable="false"
                          prefHeight="75.0"
                          prefWidth="500.0"
                          wrapText="true"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="4"/>

            </GridPane>

            <Label fx:id="information_label"
                   alignment="CENTER"
                   prefWidth="650.0"
                   textFill="#C0392B">

                <font>
                    <Font name="Times New Roman Bold" size="13.0"/>
                </font>

            </Label>

            <HBox alignment="CENTER"
                  spacing="420.0">

                <Button mnemonicParsing="false"
                        onAction="#back_button_on_action"
                        prefWidth="90.0"
                        text="← Back"/>

                <Button mnemonicParsing="false"
                        onAction="#refresh_button_on_action"
                        prefWidth="100.0"
                        style="-fx-background-color: #42AD60;
                               -fx-text-fill: white;
                               -fx-font-weight: bold;"
                        text="Refresh"/>

            </HBox>

        </VBox>
    </center>

</BorderPane>