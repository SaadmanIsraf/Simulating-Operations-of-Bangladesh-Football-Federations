<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="650.0"
            prefWidth="1000.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.summer26.section1.group10.simulatingoperationsofbangladeshfootballfederation.turjo.controller.matchofficial_registerController">

    <children>

        <Label layoutX="360.0"
               layoutY="20.0"
               text="Register as Match Official"
               style="-fx-font-size:24px; -fx-font-weight:bold;"/>

        <VBox layoutX="20.0"
              layoutY="60.0"
              prefWidth="300.0"
              spacing="10">

            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>

            <Label text="Official ID"/>
            <TextField fx:id="officialIdTF"
                       promptText="Enter Official ID"/>

            <Label text="Full Name"/>
            <TextField fx:id="nameTF"
                       promptText="Enter Full Name"/>

            <Label text="Role"/>
            <ComboBox fx:id="roleCB"/>

            <Label text="License Number"/>
            <TextField fx:id="licenseTF"
                       promptText="Enter License Number"/>

            <Label text="Experience (Years)"/>
            <TextField fx:id="experienceTF"
                       promptText="Enter Years of Experience"/>

            <HBox spacing="10">

                <Button text="Register"
                        prefWidth="90"
                        onAction="#registerButtonOnAction"/>

                <Button text="Clear"
                        prefWidth="90"
                        onAction="#clearButtonOnAction"/>

                <Button text="Back"
                        prefWidth="90"
                        onAction="#backButtonOnAction"/>

            </HBox>

        </VBox>

        <TableView fx:id="officialTable"
                   layoutX="340.0"
                   layoutY="60.0"
                   prefHeight="540.0"
                   prefWidth="630.0">

            <columns>

                <TableColumn fx:id="officialIdCol"
                             text="Official ID"
                             prefWidth="100"/>

                <TableColumn fx:id="nameCol"
                             text="Full Name"
                             prefWidth="180"/>

                <TableColumn fx:id="roleCol"
                             text="Role"
                             prefWidth="130"/>

                <TableColumn fx:id="licenseCol"
                             text="License No."
                             prefWidth="120"/>

                <TableColumn fx:id="experienceCol"
                             text="Experience"
                             prefWidth="100"/>

            </columns>

        </TableView>

    </children>

</AnchorPane>