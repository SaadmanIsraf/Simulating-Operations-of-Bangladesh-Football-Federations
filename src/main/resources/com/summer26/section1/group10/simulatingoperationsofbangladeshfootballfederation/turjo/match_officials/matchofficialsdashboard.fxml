<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="600.0"
            prefWidth="900.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.summer26.section1.group10.simulatingoperationsofbangladeshfootballfederation.turjo.controller.matchofficial_dashboardController">

    <children>

        <Label layoutX="300.0"
               layoutY="20.0"
               text="Match Official Dashboard"
               style="-fx-font-size:26px; -fx-font-weight:bold;"/>

        <Button layoutX="70.0"
                layoutY="90.0"
                prefWidth="250"
                text="Register as Match Official"
                onAction="#registerOA"/>

        <Button layoutX="70.0"
                layoutY="150.0"
                prefWidth="250"
                text="View Match Schedule"
                onAction="#viewmatchscheduleOA"/>

        <Button layoutX="70.0"
                layoutY="210.0"
                prefWidth="250"
                text="View Assigned Matches"
                onAction="#assignedmatchesOA"/>

        <Button layoutX="70.0"
                layoutY="270.0"
                prefWidth="250"
                text="Verify Player Eligibility"
                onAction="#verifyplayereligibilityOA"/>

        <Button layoutX="520.0"
                layoutY="90.0"
                prefWidth="250"
                text="Record Fouls & Cards"
                onAction="#recordfoulscardsOA"/>

        <Button layoutX="520.0"
                layoutY="150.0"
                prefWidth="250"
                text="Submit Match Report"
                onAction="#submitmatchreportOA"/>

        <Button layoutX="520.0"
                layoutY="210.0"
                prefWidth="250"
                text="Log VAR Report"
                onAction="#logvarreportOA"/>

        <Button layoutX="520.0"
                layoutY="270.0"
                prefWidth="250"
                text="Request Referee Replacement"
                onAction="#requestrefereereplacementOA"/>

        <Button layoutX="295.0"
                layoutY="360.0"
                prefWidth="300"
                text="Logout"
                onAction="#logoutOA"/>

    </children>

</AnchorPane>