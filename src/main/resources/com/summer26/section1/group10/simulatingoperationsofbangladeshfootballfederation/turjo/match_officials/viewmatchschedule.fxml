<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="500.0"
            prefWidth="800.0"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.summer26.section1.group10.simulatingoperationsofbangladeshfootballfederation.turjo.controller.matchofficial_viewmatchscheduleController">


    <Text layoutX="250.0"
          layoutY="40.0"
          text="Match Schedule">

        <font>
            <Font size="26"/>
        </font>

    </Text>


    <TableView fx:id="scheduleTable"
               layoutX="50.0"
               layoutY="90.0"
               prefWidth="700.0"
               prefHeight="280.0">

        <columns>

            <TableColumn fx:id="dateCol"
                         text="Date"
                         prefWidth="120"/>

            <TableColumn fx:id="timeCol"
                         text="Time"
                         prefWidth="100"/>

            <TableColumn fx:id="homeTeamCol"
                         text="Home Team"
                         prefWidth="150"/>

            <TableColumn fx:id="awayTeamCol"
                         text="Away Team"
                         prefWidth="150"/>

            <TableColumn fx:id="venueCol"
                         text="Venue"
                         prefWidth="150"/>

        </columns>

    </TableView>


    <Button layoutX="220.0"
            layoutY="420.0"
            prefWidth="140"
            text="Refresh"
            onAction="#refreshOA"/>


    <Button layoutX="430.0"
            layoutY="420.0"
            prefWidth="140"
            text="Back"
            onAction="#backOA"/>


</AnchorPane>