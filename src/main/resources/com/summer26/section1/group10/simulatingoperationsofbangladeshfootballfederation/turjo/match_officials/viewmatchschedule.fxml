<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="600.0"
            prefWidth="900.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.summer26.section1.group10.simulatingoperationsofbangladeshfootballfederation.turjo.controller.matchofficial_viewmatchscheduleController">

    <children>

        <Label layoutX="320.0"
               layoutY="20.0"
               text="View Match Schedule"
               style="-fx-font-size:24px; -fx-font-weight:bold;"/>

        <TableView fx:id="scheduleTable"
                   layoutX="25.0"
                   layoutY="70.0"
                   prefHeight="450.0"
                   prefWidth="850.0">

            <columns>

                <TableColumn fx:id="matchIdCol"
                             text="Match ID"
                             prefWidth="100"/>

                <TableColumn fx:id="homeTeamCol"
                             text="Home Team"
                             prefWidth="150"/>

                <TableColumn fx:id="awayTeamCol"
                             text="Away Team"
                             prefWidth="150"/>

                <TableColumn fx:id="matchDateCol"
                             text="Match Date"
                             prefWidth="140"/>

                <TableColumn fx:id="matchTimeCol"
                             text="Match Time"
                             prefWidth="120"/>

                <TableColumn fx:id="venueCol"
                             text="Venue"
                             prefWidth="190"/>

            </columns>

        </TableView>

        <Button fx:id="refreshButton"
                layoutX="290.0"
                layoutY="540.0"
                mnemonicParsing="false"
                onAction="#refreshButtonOnAction"
                prefWidth="120"
                text="Refresh"/>

        <Button fx:id="backButton"
                layoutX="470.0"
                layoutY="540.0"
                mnemonicParsing="false"
                onAction="#backButtonOnAction"
                prefWidth="120"
                text="Back"/>

    </children>

</AnchorPane>