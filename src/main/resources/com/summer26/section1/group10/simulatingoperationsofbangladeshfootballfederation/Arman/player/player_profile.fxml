<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="554.0" prefWidth="817.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.summer26.section1.group10.simulatingoperationsofbangladeshfootballfederation.Arman.player_controller.player_profile_controller">

    <top>
        <HBox alignment="CENTER" prefHeight="83.0" style="-fx-background-color: #42AD60;" BorderPane.alignment="CENTER">

            <Label text="Player Profile" textFill="WHITE">

                <font>
                    <Font name="Times New Roman Bold" size="20.0" />
                </font>
            </Label>
        </HBox>
    </top>
   <bottom>
        <AnchorPane prefHeight="471.0" prefWidth="817.0" style="-fx-background-color: #F4F7F5;" BorderPane.alignment="CENTER">

            <children>

                <!-- Current profile labels -->

                <Label layoutX="55.0" layoutY="42.0" text="Name:">
                    <font>
                        <Font name="Times New Roman Bold" size="14.0" />
                    </font>
                </Label>

                <Label fx:id="player_name_label" layoutX="145.0" layoutY="42.0" prefWidth="250.0" text="Player Name" />

                <Label layoutX="55.0" layoutY="83.0" text="Player ID:">
                    <font>
                        <Font name="Times New Roman Bold" size="14.0" />
                    </font>
                </Label>

                <Label fx:id="player_id_label" layoutX="145.0" layoutY="83.0" prefWidth="250.0" text="Player ID" />

                <Label layoutX="55.0" layoutY="124.0" text="Age:">
                    <font>
                        <Font name="Times New Roman Bold" size="14.0" />
                    </font>
                </Label>

                <Label fx:id="player_age_label" layoutX="145.0" layoutY="124.0" prefWidth="250.0" text="Player Age" />

                <Label layoutX="55.0" layoutY="165.0" text="Team Name:">
                    <font>
                        <Font name="Times New Roman Bold" size="14.0" />
                    </font>
                </Label>

                <Label fx:id="team_name_label" layoutX="145.0" layoutY="165.0" prefWidth="250.0" text="Team Name" />

                <Label layoutX="55.0" layoutY="206.0" text="Playing Position:">
                    <font>
                        <Font name="Times New Roman Bold" size="14.0" />
                    </font>
                </Label>

                <Label fx:id="playing_position_label" layoutX="180.0" layoutY="206.0" prefWidth="220.0" text="Playing Position" />

                <Label layoutX="55.0" layoutY="247.0" text="Contact Number:">
                    <font>
                        <Font name="Times New Roman Bold" size="14.0" />
                    </font>
                </Label>

                <Label fx:id="player_contact_label" layoutX="180.0" layoutY="247.0" prefWidth="220.0" text="Contact Number" />

                <!-- Editable fields -->

                <TextField fx:id="player_name_textfield" layoutX="575.0" layoutY="37.0" prefWidth="180.0" promptText="Enter full name" />

                <TextField fx:id="player_age_textfield" layoutX="575.0" layoutY="119.0" prefWidth="180.0" promptText="Enter age" />

                <TextField fx:id="player_contact_textfield" layoutX="575.0" layoutY="242.0" prefWidth="180.0" promptText="11-digit contact number" />

                <Label layoutX="59.0" layoutY="338.0" text="New Password:">
                    <font>
                        <Font name="Times New Roman Bold" size="14.0" />
                    </font>
                </Label>

                <PasswordField fx:id="new_password_field" layoutX="575.0" layoutY="333.0" prefWidth="180.0" promptText="Leave empty if unchanged" />

                <Label fx:id="information_label" alignment="CENTER" layoutX="184.0" layoutY="385.0" prefHeight="16.0" prefWidth="438.0" textFill="#C0392B">
                    <font>
                        <Font name="Times New Roman Bold" size="14.0" />
                    </font>
                </Label>

                <Button layoutX="60.0" layoutY="420.0" mnemonicParsing="false" onAction="#back_button_on_action" text="← Back" />

                <Button layoutX="660.0" layoutY="420.0" mnemonicParsing="false" onAction="#save_button_on_action" prefWidth="95.0" style="-fx-background-color: #42AD60;                                -fx-text-fill: white;                                -fx-font-weight: bold;" text="Save Changes" />
            <TextField fx:id="player_id_textfield" layoutX="575.0" layoutY="78.0" prefWidth="180.0" promptText="Player ID" />
            <TextField fx:id="team_name_textfield" layoutX="575.0" layoutY="161.0" prefWidth="180.0" promptText="Enter team name" />
            <ComboBox fx:id="playing_position_combobox" layoutX="575.0" layoutY="202.0" onAction="#playing_position_combobox_on_action" prefHeight="26.0" prefWidth="180.0" />

            </children>
        </AnchorPane>
   </bottom>

</BorderPane>
