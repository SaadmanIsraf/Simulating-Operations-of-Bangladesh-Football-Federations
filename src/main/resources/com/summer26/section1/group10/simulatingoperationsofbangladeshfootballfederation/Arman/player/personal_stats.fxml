<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="516.0" prefWidth="659.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.summer26.section1.group10.simulatingoperationsofbangladeshfootballfederation.Arman.player_controller.personal_stats_controller">

    <top>
        <HBox alignment="CENTER" prefHeight="81.0" style="-fx-background-color: #42AD60;" BorderPane.alignment="CENTER">

            <Label text="My Personal Stats" textFill="WHITE">

                <font>
                    <Font name="Times New Roman Bold" size="20.0" />
                </font>

            </Label>
        </HBox>
    </top>

    <center>
        <VBox alignment="TOP_CENTER" spacing="20.0" style="-fx-background-color: #F4F7F5;">

            <padding>
                <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
            </padding>

            <Label text="Player Performance Summary" textFill="#2F5638">

                <font>
                    <Font name="Times New Roman Bold" size="17.0" />
                </font>

            </Label>

            <Label fx:id="player_information_label" alignment="CENTER" prefWidth="560.0" text="Player ID and Name">

                <font>
                    <Font name="Times New Roman Bold" size="14.0" />
                </font>

            </Label>

            <TableView fx:id="personal_stats_table" prefHeight="230.0" prefWidth="560.0">

                <columns>

                    <TableColumn fx:id="goals_column" prefWidth="130.0" text="Goals" />

                    <TableColumn fx:id="assists_column" prefWidth="130.0" text="Assists" />

                    <TableColumn fx:id="matches_played_column" prefWidth="145.0" text="Matches Played" />

                    <TableColumn fx:id="medical_condition_column" prefWidth="172.00001831054692" text="Medical Condition" />

                </columns>

            </TableView>

            <Label fx:id="information_label" alignment="CENTER" prefHeight="25.0" prefWidth="560.0" textFill="#C0392B">

                <font>
                    <Font name="Times New Roman Bold" size="13.0" />
                </font>

            </Label>

            <HBox alignment="CENTER" spacing="350.0">

                <Button mnemonicParsing="false" onAction="#back_button_on_action" prefWidth="90.0" text="← Back" />

                <Button mnemonicParsing="false" onAction="#refresh_button_on_action" prefWidth="100.0" style="-fx-background-color: #42AD60;                                -fx-text-fill: white;                                -fx-font-weight: bold;" text="Refresh" />

            </HBox>

        </VBox>
    </center>

</BorderPane>
