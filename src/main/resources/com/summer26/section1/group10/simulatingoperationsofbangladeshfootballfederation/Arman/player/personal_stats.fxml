<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="880.0" prefWidth="1050.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.summer26.section1.group10.simulatingoperationsofbangladeshfootballfederation.Arman.player_controller.personal_stats_controller">

    <top>
        <HBox alignment="CENTER" prefHeight="82.0" style="-fx-background-color: #42AD60;" BorderPane.alignment="CENTER">

            <Label text="My Personal Statistics" textFill="WHITE">

                <font>
                    <Font name="Times New Roman Bold" size="21.0" />
                </font>

            </Label>

        </HBox>
    </top>

    <center>
        <VBox alignment="TOP_CENTER" spacing="14.0" style="-fx-background-color: #F4F7F5;">

            <padding>
                <Insets bottom="20.0" left="32.0" right="32.0" top="18.0" />
            </padding>

            <Label text="Player Performance and Complete Report" textFill="#2F5638">

                <font>
                    <Font name="Times New Roman Bold" size="18.0" />
                </font>

            </Label>

            <VBox maxWidth="970.0" spacing="13.0" style="-fx-background-color: white;                          -fx-background-radius: 10;                          -fx-border-color: #D5E3D8;                          -fx-border-radius: 10;">

                <padding>
                    <Insets bottom="18.0" left="22.0" right="22.0" top="18.0" />
                </padding>

                <Label text="Update Personal Statistics" textFill="#2F5638">

                    <font>
                        <Font name="Times New Roman Bold" size="16.0" />
                    </font>

                </Label>

                <GridPane hgap="16.0" vgap="12.0">

                    <columnConstraints>
                        <ColumnConstraints prefWidth="120.0" />
                        <ColumnConstraints prefWidth="190.0" />
                        <ColumnConstraints prefWidth="110.0" />
                        <ColumnConstraints prefWidth="170.0" />
                        <ColumnConstraints prefWidth="110.0" />
                        <ColumnConstraints prefWidth="170.0" />
                    </columnConstraints>

                    <Label text="Player ID:" GridPane.columnIndex="0" GridPane.rowIndex="0">

                        <font>
                            <Font name="Times New Roman Bold" size="13.0" />
                        </font>

                    </Label>

                    <TextField fx:id="player_id_textfield" promptText="Enter Player ID" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                    <Label text="Goals:" GridPane.columnIndex="2" GridPane.rowIndex="0">

                        <font>
                            <Font name="Times New Roman Bold" size="13.0" />
                        </font>

                    </Label>

                    <TextField fx:id="goals_textfield" promptText="Enter goals" GridPane.columnIndex="3" GridPane.rowIndex="0" />

                    <Label text="Assists:" GridPane.columnIndex="4" GridPane.rowIndex="0">

                        <font>
                            <Font name="Times New Roman Bold" size="13.0" />
                        </font>

                    </Label>

                    <TextField fx:id="assists_textfield" promptText="Enter assists" GridPane.columnIndex="5" GridPane.rowIndex="0" />

                    <Label text="Matches Played:" GridPane.columnIndex="0" GridPane.rowIndex="1">

                        <font>
                            <Font name="Times New Roman Bold" size="13.0" />
                        </font>

                    </Label>

                    <TextField fx:id="matches_played_textfield" promptText="Enter matches played" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                    <Label text="Player:" GridPane.columnIndex="2" GridPane.rowIndex="1">

                        <font>
                            <Font name="Times New Roman Bold" size="13.0" />
                        </font>

                    </Label>

                    <Label fx:id="player_information_label" text="Not Loaded" textFill="#33483A" GridPane.columnIndex="3" GridPane.columnSpan="2" GridPane.rowIndex="1" />

                    <Button mnemonicParsing="false" onAction="#save_stats_button_on_action" prefWidth="150.0" style="-fx-background-color: #42AD60;                                    -fx-text-fill: white;                                    -fx-font-weight: bold;" text="Save Statistics" GridPane.columnIndex="5" GridPane.rowIndex="1" />
               <rowConstraints>
                  <RowConstraints />
                  <RowConstraints />
               </rowConstraints>

                </GridPane>

            </VBox>

            <VBox maxWidth="970.0" spacing="8.0">

                <Label text="Saved Personal Statistics" textFill="#2F5638">

                    <font>
                        <Font name="Times New Roman Bold" size="15.0" />
                    </font>

                </Label>

                <TableView fx:id="personal_stats_table" prefHeight="242.0" prefWidth="970.0">

                    <placeholder>
                        <Label text="No personal statistics are currently available." textFill="#657269" />
                    </placeholder>

                    <columns>

                        <TableColumn fx:id="player_id_column" prefWidth="110.0" text="Player ID" />

                        <TableColumn fx:id="player_name_column" prefWidth="190.0" text="Player Name" />

                        <TableColumn fx:id="goals_column" prefWidth="110.0" text="Goals" />

                        <TableColumn fx:id="assists_column" prefWidth="110.0" text="Assists" />

                        <TableColumn fx:id="matches_played_column" prefWidth="150.0" text="Matches Played" />

                        <TableColumn fx:id="medical_condition_column" prefWidth="300.0" text="Medical Condition" />

                    </columns>

                </TableView>

            </VBox>

            <VBox maxWidth="970.0" prefHeight="68.0" prefWidth="970.0" spacing="10.0" style="-fx-background-color: #E7F0E9;                          -fx-background-radius: 8;                          -fx-border-color: #D2E0D5;                          -fx-border-radius: 8;">

                <padding>
                    <Insets bottom="12.0" left="16.0" right="16.0" top="12.0" />
                </padding>

                <HBox alignment="CENTER" spacing="15.0">
   
                   <Label alignment="TOP_LEFT" text="Search Complete Player Report" textFill="#2F5638">
   
                       <font>
                           <Font name="Times New Roman Bold" size="15.0" />
                       </font>
   
                   </Label>

                    <Label text="Player ID:">

                        <font>
                            <Font name="Times New Roman Bold" size="13.0" />
                        </font>

                    </Label>

                    <TextField fx:id="search_player_id_textfield" prefWidth="220.0" promptText="Enter Player ID" />

                    <Button mnemonicParsing="false" onAction="#search_report_button_on_action" prefWidth="170.0" style="-fx-background-color: #2F7D45;                                    -fx-text-fill: white;                                    -fx-font-weight: bold;" text="View Complete Report" />

                </HBox>

            </VBox>

            <VBox maxWidth="970.0" spacing="8.0" style="-fx-background-color: white;                          -fx-background-radius: 10;                          -fx-border-color: #D5E3D8;                          -fx-border-radius: 10;">

                <padding>
                    <Insets bottom="14.0" left="16.0" right="16.0" top="12.0" />
                </padding>

                <Label text="Complete Player Report" textFill="#2F5638">

                    <font>
                        <Font name="Times New Roman Bold" size="15.0" />
                    </font>

                </Label>

                <TextArea fx:id="complete_report_textarea" editable="false" prefHeight="300.0" prefWidth="937.0" promptText="Complete player report will appear here." style="-fx-control-inner-background: #FAFCFA;                                  -fx-font-family: Consolas;                                  -fx-font-size: 13px;" wrapText="false" />

            </VBox>

            <HBox alignment="CENTER" maxWidth="970.0">

                <Button mnemonicParsing="false" onAction="#back_button_on_action" prefWidth="100.0" text="← Back" />

                <Region HBox.hgrow="ALWAYS" />

            </HBox>

        </VBox>
    </center>

</BorderPane>
