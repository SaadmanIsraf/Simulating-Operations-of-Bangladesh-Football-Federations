<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="750.0"
            prefWidth="1100.0"
            style="-fx-background-color: #F4F7F5;"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.summer26.section1.group10.simulatingoperationsofbangladeshfootballfederation.Arman.medical_officer_controller.medical_incident_controller">

    <top>
        <HBox alignment="CENTER"
              prefHeight="70.0"
              style="-fx-background-color: #42AD60;">

            <Label text="Match Day Medical Incident"
                   textFill="WHITE">

                <font>
                    <Font name="Times New Roman Bold"
                          size="22.0"/>
                </font>
            </Label>
        </HBox>
    </top>

    <center>
        <VBox spacing="16.0">

            <padding>
                <Insets top="20.0"
                        right="30.0"
                        bottom="20.0"
                        left="30.0"/>
            </padding>

            <HBox spacing="25.0">

                <VBox prefWidth="490.0"
                      spacing="14.0"
                      style="-fx-background-color: WHITE;
                             -fx-border-color: #C8D7CC;
                             -fx-border-radius: 6;
                             -fx-background-radius: 6;
                             -fx-padding: 18;">

                    <Label text="Record New Medical Incident"
                           textFill="#2F5638">

                        <font>
                            <Font name="Times New Roman Bold"
                                  size="16.0"/>
                        </font>
                    </Label>

                    <GridPane hgap="16.0"
                              vgap="14.0">

                        <Label text="Match Date:"
                               GridPane.columnIndex="0"
                               GridPane.rowIndex="0">

                            <font>
                                <Font name="Times New Roman Bold"
                                      size="14.0"/>
                            </font>
                        </Label>

                        <DatePicker fx:id="match_date_datepicker"
                                    prefWidth="245.0"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="0"/>

                        <Label text="Player ID:"
                               GridPane.columnIndex="0"
                               GridPane.rowIndex="1">

                            <font>
                                <Font name="Times New Roman Bold"
                                      size="14.0"/>
                            </font>
                        </Label>

                        <TextField fx:id="player_id_textfield"
                                   prefWidth="245.0"
                                   promptText="Enter Player ID"
                                   GridPane.columnIndex="1"
                                   GridPane.rowIndex="1"/>

                        <Label text="Incident Type:"
                               GridPane.columnIndex="0"
                               GridPane.rowIndex="2">

                            <font>
                                <Font name="Times New Roman Bold"
                                      size="14.0"/>
                            </font>
                        </Label>

                        <ComboBox fx:id="incident_type_combobox"
                                  onAction="#incident_type_combobox_on_action"
                                  prefWidth="245.0"
                                  promptText="Select incident type"
                                  GridPane.columnIndex="1"
                                  GridPane.rowIndex="2"/>

                        <Label text="Severity:"
                               GridPane.columnIndex="0"
                               GridPane.rowIndex="3">

                            <font>
                                <Font name="Times New Roman Bold"
                                      size="14.0"/>
                            </font>
                        </Label>

                        <ComboBox fx:id="severity_combobox"
                                  onAction="#severity_combobox_on_action"
                                  prefWidth="245.0"
                                  promptText="Select severity"
                                  GridPane.columnIndex="1"
                                  GridPane.rowIndex="3"/>

                        <Label text="Action Taken:"
                               GridPane.columnIndex="0"
                               GridPane.rowIndex="4">

                            <font>
                                <Font name="Times New Roman Bold"
                                      size="14.0"/>
                            </font>
                        </Label>

                        <ComboBox fx:id="action_taken_combobox"
                                  onAction="#action_taken_on_action"
                                  prefWidth="245.0"
                                  promptText="Select action taken"
                                  GridPane.columnIndex="1"
                                  GridPane.rowIndex="4"/>

                    </GridPane>

                    <HBox alignment="CENTER_RIGHT">

                        <Button mnemonicParsing="false"
                                onAction="#submit_button_on_action"
                                prefHeight="34.0"
                                prefWidth="150.0"
                                style="-fx-background-color: #42AD60;
                                       -fx-text-fill: white;
                                       -fx-font-weight: bold;"
                                text="Submit Incident"/>
                    </HBox>
                </VBox>

                <VBox prefWidth="520.0"
                      spacing="14.0"
                      style="-fx-background-color: WHITE;
                             -fx-border-color: #C8D7CC;
                             -fx-border-radius: 6;
                             -fx-background-radius: 6;
                             -fx-padding: 18;">

                    <Label text="Search Player Incident History"
                           textFill="#2F5638">

                        <font>
                            <Font name="Times New Roman Bold"
                                  size="16.0"/>
                        </font>
                    </Label>

                    <HBox alignment="CENTER_LEFT"
                          spacing="10.0">

                        <Label text="Player ID:">

                            <font>
                                <Font name="Times New Roman Bold"
                                      size="14.0"/>
                            </font>
                        </Label>

                        <TextField fx:id="search_player_id_textfield"
                                   prefWidth="260.0"
                                   promptText="Enter Player ID"/>

                        <Button mnemonicParsing="false"
                                onAction="#search_button_on_action"
                                prefWidth="85.0"
                                style="-fx-background-color: #42AD60;
                                       -fx-text-fill: white;
                                       -fx-font-weight: bold;"
                                text="Search"/>
                    </HBox>

                    <TextArea fx:id="player_incident_details_textarea"
                              editable="false"
                              prefHeight="220.0"
                              prefWidth="480.0"
                              promptText="Player details and medical incidents will appear here..."
                              wrapText="true"/>
                </VBox>
            </HBox>

            <Label text="Medical Incident History"
                   textFill="#2F5638">

                <font>
                    <Font name="Times New Roman Bold"
                          size="16.0"/>
                </font>
            </Label>

            <TableView fx:id="medical_incident_tableview"
                       prefHeight="280.0">

                <columns>

                    <TableColumn fx:id="match_date_column"
                                 prefWidth="175.0"
                                 text="Match Date"/>

                    <TableColumn fx:id="player_id_column"
                                 prefWidth="150.0"
                                 text="Player ID"/>

                    <TableColumn fx:id="incident_type_column"
                                 prefWidth="235.0"
                                 text="Incident Type"/>

                    <TableColumn fx:id="severity_column"
                                 prefWidth="170.0"
                                 text="Severity"/>

                    <TableColumn fx:id="action_taken_column"
                                 prefWidth="310.0"
                                 text="Action Taken"/>

                </columns>
            </TableView>

            <HBox alignment="CENTER_LEFT">

                <Button mnemonicParsing="false"
                        onAction="#back_button_on_action"
                        prefWidth="85.0"
                        text="← Back"/>
            </HBox>
        </VBox>
    </center>

</BorderPane>