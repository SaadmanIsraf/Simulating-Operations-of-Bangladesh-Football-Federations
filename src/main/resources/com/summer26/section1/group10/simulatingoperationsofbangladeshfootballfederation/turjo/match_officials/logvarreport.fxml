<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="650.0"
            prefWidth="1000.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.summer26.section1.group10.simulatingoperationsofbangladeshfootballfederation.turjo.controller.matchofficial_logvarreportController">

    <children>

        <Label layoutX="400.0"
               layoutY="20.0"
               text="Log VAR Report"
               style="-fx-font-size:24px; -fx-font-weight:bold;"/>

        <VBox layoutX="20.0"
              layoutY="60.0"
              prefWidth="300.0"
              spacing="10">

            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>

            <Label text="Match ID"/>
            <TextField fx:id="matchIdTF"
                       promptText="Enter Match ID"/>

            <Label text="Minute"/>
            <TextField fx:id="minuteTF"
                       promptText="e.g. 67"/>

            <Label text="Player Name"/>
            <TextField fx:id="playerNameTF"
                       promptText="Enter Player Name"/>

            <Label text="Review Type"/>
            <ComboBox fx:id="reviewTypeCB"/>

            <Label text="Decision"/>
            <ComboBox fx:id="decisionCB"/>

            <Label text="Report Details"/>
            <TextArea fx:id="detailsTA"
                      prefHeight="100"
                      wrapText="true"
                      promptText="Enter VAR report details"/>

            <HBox spacing="10">

                <Button text="Submit"
                        prefWidth="90"
                        onAction="#submitButtonOnAction"/>

                <Button text="Clear"
                        prefWidth="90"
                        onAction="#clearButtonOnAction"/>

                <Button text="Back"
                        prefWidth="90"
                        onAction="#backButtonOnAction"/>

            </HBox>

        </VBox>

        <TableView fx:id="varReportTable"
                   layoutX="340.0"
                   layoutY="60.0"
                   prefHeight="540.0"
                   prefWidth="630.0">

            <columns>

                <TableColumn fx:id="matchIdCol"
                             text="Match ID"
                             prefWidth="90"/>

                <TableColumn fx:id="minuteCol"
                             text="Minute"
                             prefWidth="70"/>

                <TableColumn fx:id="playerNameCol"
                             text="Player"
                             prefWidth="140"/>

                <TableColumn fx:id="reviewTypeCol"
                             text="Review Type"
                             prefWidth="130"/>

                <TableColumn fx:id="decisionCol"
                             text="Decision"
                             prefWidth="100"/>

                <TableColumn fx:id="detailsCol"
                             text="Details"
                             prefWidth="100"/>

            </columns>

        </TableView>

    </children>

</AnchorPane>