<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="504.0" prefWidth="674.0" style="-fx-background-color: E6E8AC;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.summer26.section1.group10.simulatingoperationsofbangladeshfootballfederation.Ruba.StandingsController">
    <children>
        <Label layoutX="207.0" layoutY="14.0" text="Tournament Standings">
            <font>
                <Font size="26.0" />
            </font>
        </Label>

        <Label layoutX="38.0" layoutY="75.0" text="Tournament :" />

        <ComboBox fx:id="tournamentComboBox" layoutX="146.0" layoutY="71.0" prefWidth="150.0" />

        <Button layoutX="442.0" layoutY="80.0" mnemonicParsing="false" onAction="#viewStandings" text="View Standings" />

        <TableView fx:id="standingTable" layoutX="74.0" layoutY="150.0" prefHeight="260.0" prefWidth="520.0">
            <columns>
                <TableColumn fx:id="rankColumn" prefWidth="100.0" text="Rank" />
                <TableColumn fx:id="teamColumn" prefWidth="180.0" text="Team" />
                <TableColumn fx:id="playedColumn" prefWidth="120.0" text="Played" />
                <TableColumn fx:id="pointsColumn" prefWidth="120.0" text="Points" />
            </columns>
        </TableView>
      <Button layoutX="48.0" layoutY="452.0" mnemonicParsing="false" onAction="#backBtnOnAction" text="Back" />

    </children>
</AnchorPane>
