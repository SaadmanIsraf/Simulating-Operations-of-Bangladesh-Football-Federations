<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity"
            maxWidth="-Infinity"
            minHeight="-Infinity"
            minWidth="-Infinity"
            prefHeight="516.0"
            prefWidth="659.0"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.summer26.section1.group10.simulatingoperationsofbangladeshfootballfederation.Arman.player_controller.player_dashboard_controller">

    <top>
        <HBox alignment="CENTER"
              prefHeight="81.0"
              style="-fx-background-color: #42AD60;"
              BorderPane.alignment="CENTER">

            <Label alignment="CENTER"
                   text="Player Dashboard"
                   textFill="WHITE">

                <font>
                    <Font name="Times New Roman Bold" size="18.0"/>
                </font>

            </Label>

        </HBox>
    </top>

    <center>
        <HBox alignment="CENTER"
              BorderPane.alignment="CENTER">

            <children>

                <VBox alignment="CENTER" spacing="15.0">

                    <Button mnemonicParsing="false"
                            onAction="#player_profile_button_on_action"
                            prefHeight="26.0"
                            prefWidth="222.0"
                            text="Player Profile">

                        <font>
                            <Font name="Times New Roman Bold" size="12.0"/>
                        </font>

                    </Button>

                    <Button mnemonicParsing="false"
                            onAction="#training_schedule_button_on_action"
                            prefHeight="26.0"
                            prefWidth="222.0"
                            text="Training Schedule">

                        <font>
                            <Font name="Times New Roman Bold" size="12.0"/>
                        </font>

                    </Button>

                    <Button mnemonicParsing="false"
                            onAction="#team_details_button_on_action"
                            prefHeight="26.0"
                            prefWidth="222.0"
                            text="Team Details">

                        <font>
                            <Font name="Times New Roman Bold" size="12.0"/>
                        </font>

                    </Button>

                    <Button mnemonicParsing="false"
                            onAction="#tournament_rules_button_on_action"
                            prefHeight="26.0"
                            prefWidth="222.0"
                            text="Tournament Rules">

                        <font>
                            <Font name="Times New Roman Bold" size="12.0"/>
                        </font>

                    </Button>

                    <Button mnemonicParsing="false"
                            onAction="#personal_stats_button_on_action"
                            prefHeight="26.0"
                            prefWidth="222.0"
                            text="My Stats">

                        <font>
                            <Font name="Times New Roman Bold" size="12.0"/>
                        </font>

                    </Button>

                    <Button mnemonicParsing="false"
                            onAction="#join_team_request_button_on_action"
                            prefHeight="26.0"
                            prefWidth="222.0"
                            text="Request to Join a Team">

                        <font>
                            <Font name="Times New Roman Bold" size="12.0"/>
                        </font>

                    </Button>

                    <Button mnemonicParsing="false"
                            onAction="#match_schedule_button_on_action"
                            prefHeight="26.0"
                            prefWidth="222.0"
                            text="Match Schedule">

                        <font>
                            <Font name="Times New Roman Bold" size="12.0"/>
                        </font>

                    </Button>

                    <Button mnemonicParsing="false"
                            onAction="#coach_information_button_on_action"
                            prefHeight="26.0"
                            prefWidth="222.0"
                            text="Coach Information">

                        <font>
                            <Font name="Times New Roman Bold" size="12.0"/>
                        </font>

                    </Button>

                    <Button mnemonicParsing="false"
                            onAction="#logout_button_on_action"
                            prefHeight="26.0"
                            prefWidth="222.0"
                            text="Logout">

                        <font>
                            <Font name="Times New Roman Bold" size="12.0"/>
                        </font>

                    </Button>

                </VBox>

            </children>

        </HBox>
    </center>

</BorderPane>