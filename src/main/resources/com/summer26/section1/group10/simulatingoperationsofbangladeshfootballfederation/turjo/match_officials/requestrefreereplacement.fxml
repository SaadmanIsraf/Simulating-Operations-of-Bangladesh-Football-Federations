<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="550.0" prefWidth="850.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.summer26.section1.group10.simulatingoperationsofbangladeshfootballfederation.turjo.controller.matchofficial_requestrefereereplacementController">


    <Label layoutX="240.0" layoutY="30.0" text="Request Referee Replacement" textFill="#133799">

        <font>
            <Font size="26" />
        </font>

    </Label>



    <!-- Match -->

    <Label layoutX="70.0" layoutY="100.0" text="Match ID" />

    <TextField fx:id="matchIdTF" layoutX="70.0" layoutY="125.0" prefWidth="220" promptText="Enter Match ID" />



    <!-- Current Referee -->

    <Label layoutX="400.0" layoutY="100.0" text="Current Referee" />

    <TextField fx:id="currentRefereeTF" layoutX="400.0" layoutY="125.0" prefWidth="220" promptText="Referee Name" />




    <!-- Reason -->

    <Label layoutX="70.0" layoutY="210.0" text="Replacement Reason" />



    <!-- Priority -->

    <Label layoutX="400.0" layoutY="210.0" text="Priority" />

    <ComboBox fx:id="priorityCB" layoutX="400.0" layoutY="235.0" prefWidth="220" promptText="Normal / Urgent" />




    <!-- Details -->

    <Label layoutX="70.0" layoutY="320.0" text="Additional Details" />

    <TextArea fx:id="detailsTA" layoutX="70.0" layoutY="345.0" prefHeight="80" prefWidth="550" promptText="Explain replacement request" />




    <!-- Buttons -->

    <Button layoutX="150.0" layoutY="480.0" onAction="#submitRequestOA" prefWidth="150" text="Submit Request" />


    <Button layoutX="370.0" layoutY="480.0" onAction="#clearOA" prefWidth="120" text="Clear" />


    <Button layoutX="560.0" layoutY="480.0" onAction="#backOA" prefWidth="120" text="Back" />
   <TextField fx:id="matchIdTF1" layoutX="70.0" layoutY="241.0" prefWidth="220" promptText="Reason for replacement" />


</AnchorPane>
