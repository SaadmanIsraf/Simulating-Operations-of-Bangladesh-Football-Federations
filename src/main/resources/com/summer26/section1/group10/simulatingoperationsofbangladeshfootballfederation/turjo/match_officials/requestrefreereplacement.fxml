<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="650.0"
            prefWidth="1000.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.summer26.section1.group10.simulatingoperationsofbangladeshfootballfederation.turjo.controller.matchofficial_requestrefereereplacementController">

    <children>

        <Label layoutX="330.0"
               layoutY="20.0"
               text="Request Referee Replacement"
               style="-fx-font-size:24px; -fx-font-weight:bold;"/>

        <VBox layoutX="20.0"
              layoutY="60.0"
              prefWidth="310.0"
              spacing="10">

            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>

            <Label text="Match ID"/>
            <TextField fx:id="matchIdTF"
                       promptText="Enter Match ID"/>

            <Label text="Current Referee"/>
            <TextField fx:id="currentRefereeTF"
                       promptText="Enter Referee Name"/>

            <Label text="Replacement Reason"/>
            <TextArea fx:id="reasonTA"
                      prefHeight="100"
                      wrapText="true"
                      promptText="Reason for replacement"/>

            <Label text="Priority"/>
            <ComboBox fx:id="priorityCB"/>

            <Label text="Request Status"/>
            <ComboBox fx:id="statusCB"/>

            <HBox spacing="10">

                <Button text="Submit"
                        prefWidth="90"
                        onAction="#submitButtonOnAction"/>

                <Button text="Clear"
                        prefWidth="90"
                        onAction="#clearButtonOnAction"/>

                <Button text="Back"
                        prefWidth="90"
                        onAction="#backButtonOnAction"/>

            </HBox>

        </VBox>

        <TableView fx:id="requestTable"
                   layoutX="350.0"
                   layoutY="60.0"
                   prefHeight="550.0"
                   prefWidth="620.0">

            <columns>

                <TableColumn fx:id="matchIdCol"
                             text="Match ID"
                             prefWidth="110"/>

                <TableColumn fx:id="refereeCol"
                             text="Current Referee"
                             prefWidth="170"/>

                <TableColumn fx:id="reasonCol"
                             text="Reason"
                             prefWidth="170"/>

                <TableColumn fx:id="priorityCol"
                             text="Priority"
                             prefWidth="80"/>

                <TableColumn fx:id="statusCol"
                             text="Status"
                             prefWidth="90"/>

            </columns>

        </TableView>

    </children>

</AnchorPane>