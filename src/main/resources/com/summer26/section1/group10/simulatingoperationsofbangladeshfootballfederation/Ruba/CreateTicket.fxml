<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="520.0" prefWidth="700.0" style="-fx-background-color: E6E8AC;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.summer26.section1.group10.simulatingoperationsofbangladeshfootballfederation.Ruba.CreateTicketController">
    <children>
        <Label layoutX="230.0" layoutY="20.0" text="Create Ticket">
            <font>
                <Font size="24.0" />
            </font>
        </Label>

        <Label layoutX="40.0" layoutY="80.0" text="Match :" />
        <ComboBox fx:id="matchComboBox" layoutX="140.0" layoutY="76.0" prefWidth="260.0" promptText="Select Match" />

        <Label layoutX="40.0" layoutY="120.0" text="Category :" />
        <ComboBox fx:id="categoryComboBox" layoutX="140.0" layoutY="116.0" prefWidth="180.0" promptText="Select Category" />

        <Label layoutX="40.0" layoutY="160.0" text="Price :" />
        <TextField fx:id="priceField" layoutX="140.0" layoutY="156.0" prefWidth="150.0" promptText="e.g. 500" />

        <Label layoutX="320.0" layoutY="160.0" text="Quantity :" />
        <TextField fx:id="quantityField" layoutX="400.0" layoutY="156.0" prefWidth="100.0" promptText="e.g. 50" />

        <Button layoutX="140.0" layoutY="200.0" mnemonicParsing="false" onAction="#saveTicket" text="Save" />

        <Label fx:id="statusLabel" layoutX="40.0" layoutY="240.0" prefWidth="600.0" text="" />

        <TableView fx:id="ticketTable" layoutX="40.0" layoutY="280.0" prefHeight="180.0" prefWidth="620.0">
            <columns>
                <TableColumn fx:id="matchColumn" prefWidth="230.0" text="Match" />
                <TableColumn fx:id="categoryColumn" prefWidth="120.0" text="Category" />
                <TableColumn fx:id="priceColumn" prefWidth="120.0" text="Price" />
                <TableColumn fx:id="quantityColumn" prefWidth="120.0" text="Quantity" />
            </columns>
        </TableView>

        <Button layoutX="40.0" layoutY="475.0" mnemonicParsing="false" onAction="#backBtnOnAction" text="Back" />
    </children>
</AnchorPane>