<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="516.0" prefWidth="659.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.summer26.section1.group10.simulatingoperationsofbangladeshfootballfederation.Arman.player_controller.training_schedule_controller">

    <top>
        <HBox alignment="CENTER" prefHeight="81.0" style="-fx-background-color: #42AD60;" BorderPane.alignment="CENTER">

            <Label text="Training Schedule" textFill="WHITE">

                <font>
                    <Font name="Times New Roman Bold" size="20.0" />
                </font>

            </Label>

        </HBox>
    </top>

    <center>
        <VBox alignment="TOP_CENTER" prefHeight="442.0" prefWidth="659.0" spacing="18.0" style="-fx-background-color: #F4F7F5;">

            <padding>
                <Insets bottom="25.0" left="35.0" right="35.0" top="25.0" />
            </padding>

            <Label text="Upcoming Training Sessions" textFill="#2F5638">

                <font>
                    <Font name="Times New Roman Bold" size="17.0" />
                </font>

            </Label>

            <TableView fx:id="training_schedule_tableview" prefHeight="300.0" prefWidth="580.0">

                <columns>

                    <TableColumn fx:id="training_date_column" prefWidth="130.0" text="Training Date" />

                    <TableColumn fx:id="training_time_column" prefWidth="150.40000915527344" text="Training Time" />

                    <TableColumn fx:id="venue_column" prefWidth="160.0" text="Venue" />

                    <TableColumn fx:id="coach_column" prefWidth="148.79995727539062" text="Assigned Coach" />

                </columns>

            </TableView>

            <Label fx:id="information_label" alignment="CENTER" prefHeight="25.0" prefWidth="580.0" textFill="#C0392B">

                <font>
                    <Font name="Times New Roman Bold" size="13.0" />
                </font>

            </Label>

            <HBox alignment="CENTER" spacing="350.0">

                <Button mnemonicParsing="false" onAction="#back_button_on_action" prefWidth="90.0" text="← Back" />

                <Button mnemonicParsing="false" onAction="#refresh_button_on_action" prefWidth="100.0" style="-fx-background-color: #42AD60;                                -fx-text-fill: white;                                -fx-font-weight: bold;" text="Refresh" />

            </HBox>

        </VBox>
    </center>

</BorderPane>
