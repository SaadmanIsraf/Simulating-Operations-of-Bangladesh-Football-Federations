<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="900.0"
            prefWidth="1100.0"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.summer26.section1.group10.simulatingoperationsofbangladeshfootballfederation.Arman.player_controller.training_schedule_controller">

    <top>
        <HBox alignment="CENTER"
              prefHeight="82.0"
              style="-fx-background-color: #42AD60;"
              BorderPane.alignment="CENTER">

            <Label text="Training Schedule and Enrollment"
                   textFill="WHITE">

                <font>
                    <Font name="Times New Roman Bold"
                          size="22.0"/>
                </font>
            </Label>
        </HBox>
    </top>

    <center>
        <VBox alignment="TOP_CENTER"
              spacing="14.0"
              style="-fx-background-color: #F4F7F5;">

            <padding>
                <Insets top="18.0"
                        right="30.0"
                        bottom="20.0"
                        left="30.0"/>
            </padding>

            <Label text="Choose a Suitable Training Session and Enroll"
                   textFill="#2F5638">

                <font>
                    <Font name="Times New Roman Bold"
                          size="18.0"/>
                </font>
            </Label>

            <VBox maxWidth="1000.0"
                  spacing="14.0"
                  style="-fx-background-color: WHITE;
                         -fx-background-radius: 10;
                         -fx-border-color: #D5E3D8;
                         -fx-border-radius: 10;">

                <padding>
                    <Insets top="16.0"
                            right="22.0"
                            bottom="16.0"
                            left="22.0"/>
                </padding>

                <Label text="Training Session Enrollment"
                       textFill="#2F5638">

                    <font>
                        <Font name="Times New Roman Bold"
                              size="16.0"/>
                    </font>
                </Label>

                <GridPane hgap="18.0"
                          vgap="13.0">

                    <columnConstraints>
                        <ColumnConstraints halignment="RIGHT"
                                           minWidth="125.0"
                                           prefWidth="140.0"/>

                        <ColumnConstraints minWidth="240.0"
                                           prefWidth="285.0"/>

                        <ColumnConstraints halignment="RIGHT"
                                           minWidth="125.0"
                                           prefWidth="140.0"/>

                        <ColumnConstraints minWidth="240.0"
                                           prefWidth="285.0"/>
                    </columnConstraints>

                    <rowConstraints>
                        <RowConstraints minHeight="36.0"/>
                        <RowConstraints minHeight="36.0"/>
                        <RowConstraints minHeight="40.0"/>
                    </rowConstraints>

                    <Label text="Player ID:"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="0">

                        <font>
                            <Font name="Times New Roman Bold"
                                  size="13.0"/>
                        </font>
                    </Label>

                    <TextField fx:id="player_id_textfield"
                               prefWidth="275.0"
                               promptText="Enter Player ID"
                               GridPane.columnIndex="1"
                               GridPane.rowIndex="0"/>

                    <Label text="Training Date:"
                           GridPane.columnIndex="2"
                           GridPane.rowIndex="0">

                        <font>
                            <Font name="Times New Roman Bold"
                                  size="13.0"/>
                        </font>
                    </Label>

                    <DatePicker fx:id="training_date_datepicker"
                                onAction="#training_date_datepicker_on_action"
                                prefWidth="275.0"
                                promptText="Select training date"
                                GridPane.columnIndex="3"
                                GridPane.rowIndex="0"/>

                    <Label text="Training Time:"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="1">

                        <font>
                            <Font name="Times New Roman Bold"
                                  size="13.0"/>
                        </font>
                    </Label>

                    <ComboBox fx:id="training_time_combobox"
                              onAction="#training_time_combobox_on_action"
                              prefWidth="275.0"
                              promptText="Select fixed training time"
                              GridPane.columnIndex="1"
                              GridPane.rowIndex="1"/>

                    <Label text="Training Venue:"
                           GridPane.columnIndex="2"
                           GridPane.rowIndex="1">

                        <font>
                            <Font name="Times New Roman Bold"
                                  size="13.0"/>
                        </font>
                    </Label>

                    <ComboBox fx:id="venue_combobox"
                              onAction="#venue_combobox_on_action"
                              prefWidth="275.0"
                              promptText="Select venue"
                              GridPane.columnIndex="3"
                              GridPane.rowIndex="1"/>

                    <Label text="Assigned Coach:"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="2">

                        <font>
                            <Font name="Times New Roman Bold"
                                  size="13.0"/>
                        </font>
                    </Label>

                    <ComboBox fx:id="coach_combobox"
                              onAction="#coach_combobox_on_action"
                              prefWidth="275.0"
                              promptText="Select coach"
                              GridPane.columnIndex="1"
                              GridPane.rowIndex="2"/>

                    <HBox alignment="CENTER_RIGHT"
                          spacing="18.0"
                          GridPane.columnIndex="2"
                          GridPane.columnSpan="2"
                          GridPane.rowIndex="2">

                        <Label fx:id="capacity_information_label"
                               text="Maximum capacity: 11 players"
                               textFill="#5C6F61">

                            <font>
                                <Font name="Times New Roman"
                                      size="13.0"/>
                            </font>
                        </Label>

                        <Button mnemonicParsing="false"
                                onAction="#enroll_button_on_action"
                                prefWidth="165.0"
                                style="-fx-background-color: #42AD60;
                                       -fx-text-fill: white;
                                       -fx-font-weight: bold;
                                       -fx-background-radius: 5;"
                                text="Enroll in Training"/>
                    </HBox>

                </GridPane>
            </VBox>

            <VBox maxWidth="1000.0"
                  spacing="10.0"
                  style="-fx-background-color: #E7F0E9;
                         -fx-background-radius: 8;
                         -fx-border-color: #D2E0D5;
                         -fx-border-radius: 8;">

                <padding>
                    <Insets top="12.0"
                            right="16.0"
                            bottom="12.0"
                            left="16.0"/>
                </padding>

                <Label text="Search Training Enrollment"
                       textFill="#2F5638">

                    <font>
                        <Font name="Times New Roman Bold"
                              size="15.0"/>
                    </font>
                </Label>

                <HBox alignment="CENTER"
                      spacing="12.0">

                    <Label text="Player ID:">
                        <font>
                            <Font name="Times New Roman Bold"
                                  size="13.0"/>
                        </font>
                    </Label>

                    <TextField fx:id="search_player_id_textfield"
                               prefWidth="160.0"
                               promptText="Enter Player ID"/>

                    <Label text="Coach:">
                        <font>
                            <Font name="Times New Roman Bold"
                                  size="13.0"/>
                        </font>
                    </Label>

                    <ComboBox fx:id="search_coach_combobox"
                              prefWidth="225.0"
                              promptText="Choose coach"/>

                    <Label text="Training Time:">
                        <font>
                            <Font name="Times New Roman Bold"
                                  size="13.0"/>
                        </font>
                    </Label>

                    <ComboBox fx:id="search_time_combobox"
                              prefWidth="225.0"
                              promptText="Choose training time"/>

                    <Button mnemonicParsing="false"
                            onAction="#search_button_on_action"
                            prefWidth="105.0"
                            style="-fx-background-color: #2F7D45;
                                   -fx-text-fill: white;
                                   -fx-font-weight: bold;"
                            text="Search"/>
                </HBox>
            </VBox>


            <VBox maxWidth="1000.0"
                  spacing="7.0">

                <Label text="Training Sessions"
                       textFill="#2F5638">

                    <font>
                        <Font name="Times New Roman Bold"
                              size="15.0"/>
                    </font>
                </Label>

                <TableView fx:id="training_schedule_tableview"
                           prefHeight="230.0"
                           prefWidth="1000.0">

                    <placeholder>
                        <Label text="No training sessions are currently available."
                               textFill="#657269"/>
                    </placeholder>

                    <columns>
                        <TableColumn fx:id="training_id_column"
                                     prefWidth="100.0"
                                     text="Training ID"/>

                        <TableColumn fx:id="training_date_column"
                                     prefWidth="145.0"
                                     text="Training Date"/>

                        <TableColumn fx:id="training_time_column"
                                     prefWidth="170.0"
                                     text="Training Time"/>

                        <TableColumn fx:id="venue_column"
                                     prefWidth="215.0"
                                     text="Venue"/>

                        <TableColumn fx:id="coach_column"
                                     prefWidth="195.0"
                                     text="Assigned Coach"/>

                        <TableColumn fx:id="enrollment_count_column"
                                     prefWidth="130.0"
                                     text="Enrollment"/>

                        <TableColumn fx:id="session_status_column"
                                     prefWidth="120.0"
                                     text="Status"/>
                    </columns>
                </TableView>
            </VBox>


            <VBox maxWidth="1000.0"
                  spacing="8.0"
                  style="-fx-background-color: WHITE;
                         -fx-background-radius: 10;
                         -fx-border-color: #D5E3D8;
                         -fx-border-radius: 10;">

                <padding>
                    <Insets top="12.0"
                            right="16.0"
                            bottom="14.0"
                            left="16.0"/>
                </padding>

                <Label text="Player and Training Details"
                       textFill="#2F5638">

                    <font>
                        <Font name="Times New Roman Bold"
                              size="15.0"/>
                    </font>
                </Label>

                <TextArea fx:id="search_result_textarea"
                          editable="false"
                          prefHeight="155.0"
                          prefWidth="960.0"
                          promptText="Search for a player enrollment or select a row from the table to view details."
                          style="-fx-control-inner-background: #FAFCFA;
                                 -fx-font-family: 'Consolas';
                                 -fx-font-size: 13px;"
                          wrapText="false"/>
            </VBox>

            <Label fx:id="information_label"
                   alignment="CENTER"
                   prefHeight="24.0"
                   prefWidth="950.0"
                   textFill="#C0392B">

                <font>
                    <Font name="Times New Roman Bold"
                          size="13.0"/>
                </font>
            </Label>

            <HBox alignment="CENTER"
                  maxWidth="1000.0">

                <Button mnemonicParsing="false"
                        onAction="#back_button_on_action"
                        prefWidth="110.0"
                        text="← Back"/>

                <Region HBox.hgrow="ALWAYS"/>
            </HBox>

        </VBox>
    </center>

</BorderPane>