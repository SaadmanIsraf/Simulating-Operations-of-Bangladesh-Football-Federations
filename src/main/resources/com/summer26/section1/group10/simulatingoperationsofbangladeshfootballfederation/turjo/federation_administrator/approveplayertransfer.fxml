<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="450.0" prefWidth="700.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.summer26.section1.group10.simulatingoperationsofbangladeshfootballfederation.turjo.controller.federation_administrator_approveplayertransferController">


    <Label layoutX="240.0" layoutY="30.0" style="-fx-font-size:22px; -fx-font-weight:bold;" text="Approve Player Transfer" textFill="#9e7c25" />

    <Label fx:id="messageLabel"
           layoutX="230.0"
           layoutY="390.0"
           style="-fx-font-size:16px; -fx-font-weight:bold;"
           text=""/>
    <Label layoutX="60.0" layoutY="100.0" text="Player Name" />

    <TextField fx:id="playerNameTF" layoutX="60.0" layoutY="125.0" prefWidth="200" />


    <Label layoutX="350.0" layoutY="100.0" text="From Club" />

    <TextField fx:id="fromClubTF" layoutX="350.0" layoutY="125.0" prefWidth="200" />


    <Label layoutX="60.0" layoutY="190.0" text="To Club" />

    <TextField fx:id="toClubTF" layoutX="60.0" layoutY="215.0" prefWidth="200" />


    <Label layoutX="350.0" layoutY="190.0" text="Transfer Decision" />

    <ComboBox fx:id="decisionCB" layoutX="350.0" layoutY="215.0" prefWidth="200" promptText="Select" />


    <Button layoutX="67.0" layoutY="333.0" onAction="#verifyTransferOA" prefWidth="120" text="Verify" />


    <Button layoutX="276.0" layoutY="333.0" onAction="#saveOA" prefWidth="120" text="Save" />


    <Button layoutX="507.0" layoutY="333.0" onAction="#backOA" prefWidth="100" text="Back" textFill="#991d1d" />


</AnchorPane>
