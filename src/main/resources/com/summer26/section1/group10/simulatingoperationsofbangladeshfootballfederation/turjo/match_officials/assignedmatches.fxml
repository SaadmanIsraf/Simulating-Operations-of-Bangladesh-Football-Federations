<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="600.0"
            prefWidth="1000.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.summer26.section1.group10.simulatingoperationsofbangladeshfootballfederation.turjo.controller.matchofficial_viewassignedmatchesController">

    <children>

        <Label layoutX="340.0"
               layoutY="20.0"
               text="View Assigned Matches"
               style="-fx-font-size:24px; -fx-font-weight:bold;" />

        <Label layoutX="30.0" layoutY="80.0" text="Match ID"/>
        <TextField fx:id="matchIdTF"
                   layoutX="150.0"
                   layoutY="75.0"
                   prefWidth="180.0"/>

        <Label layoutX="30.0" layoutY="120.0" text="Home Team"/>
        <TextField fx:id="homeTeamTF"
                   layoutX="150.0"
                   layoutY="115.0"
                   prefWidth="180.0"/>

        <Label layoutX="30.0" layoutY="160.0" text="Away Team"/>
        <TextField fx:id="awayTeamTF"
                   layoutX="150.0"
                   layoutY="155.0"
                   prefWidth="180.0"/>

        <Label layoutX="30.0" layoutY="200.0" text="Venue"/>
        <TextField fx:id="venueTF"
                   layoutX="150.0"
                   layoutY="195.0"
                   prefWidth="180.0"/>

        <Label layoutX="30.0" layoutY="240.0" text="Date"/>
        <DatePicker fx:id="dateDP"
                    layoutX="150.0"
                    layoutY="235.0"
                    prefWidth="180.0"/>

        <Label layoutX="30.0" layoutY="280.0" text="Time"/>
        <TextField fx:id="timeTF"
                   layoutX="150.0"
                   layoutY="275.0"
                   prefWidth="180.0"/>

        <Label layoutX="30.0" layoutY="320.0" text="Role"/>
        <ComboBox fx:id="roleCB"
                  layoutX="150.0"
                  layoutY="315.0"
                  prefWidth="180.0"/>

        <Button layoutX="30.0"
                layoutY="380.0"
                prefWidth="80.0"
                text="Add"
                onAction="#addButtonOnAction"/>

        <Button layoutX="120.0"
                layoutY="380.0"
                prefWidth="80.0"
                text="Update"
                onAction="#updateButtonOnAction"/>

        <Button layoutX="210.0"
                layoutY="380.0"
                prefWidth="80.0"
                text="Delete"
                onAction="#deleteButtonOnAction"/>

        <Button layoutX="75.0"
                layoutY="430.0"
                prefWidth="170.0"
                text="Clear"
                onAction="#clearButtonOnAction"/>

        <Button layoutX="75.0"
                layoutY="480.0"
                prefWidth="170.0"
                text="Back"
                onAction="#backButtonOnAction"/>

        <TableView fx:id="assignedMatchesTable"
                   layoutX="370.0"
                   layoutY="70.0"
                   prefWidth="610.0"
                   prefHeight="480.0"
                   onMouseClicked="#tableMouseClicked">

            <columns>

                <TableColumn fx:id="matchIdCol"
                             text="Match ID"
                             prefWidth="70.0"/>

                <TableColumn fx:id="homeTeamCol"
                             text="Home Team"
                             prefWidth="100.0"/>

                <TableColumn fx:id="awayTeamCol"
                             text="Away Team"
                             prefWidth="100.0"/>

                <TableColumn fx:id="venueCol"
                             text="Venue"
                             prefWidth="100.0"/>

                <TableColumn fx:id="dateCol"
                             text="Date"
                             prefWidth="90.0"/>

                <TableColumn fx:id="timeCol"
                             text="Time"
                             prefWidth="70.0"/>

                <TableColumn fx:id="roleCol"
                             text="Assigned Role"
                             prefWidth="150.0"/>

            </columns>

        </TableView>

    </children>

</AnchorPane>