<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="650.0"
            prefWidth="900.0"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.summer26.section1.group10.simulatingoperationsofbangladeshfootballfederation.turjo.controller.matchofficial_assignedmatchesController">


    <!-- Title -->

    <Label layoutX="280.0"
           layoutY="25.0"
           text="My Assigned Matches"
           textFill="#133799">

        <font>
            <Font size="26"/>
        </font>

    </Label>



    <!-- Official ID -->

    <Label layoutX="70.0"
           layoutY="90.0"
           text="Official ID"/>

    <TextField fx:id="officialIdTF"
               layoutX="70.0"
               layoutY="115.0"
               prefWidth="200"
               promptText="Enter your ID"/>



    <!-- Official Name -->

    <Label layoutX="320.0"
           layoutY="90.0"
           text="Official Name"/>

    <TextField fx:id="officialNameTF"
               layoutX="320.0"
               layoutY="115.0"
               prefWidth="250"
               promptText="Enter your name"/>



    <!-- Search Button -->

    <Button layoutX="620.0"
            layoutY="113.0"
            prefWidth="160"
            text="View My Matches"
            onAction="#viewAssignedMatchesOA"/>



    <!-- Message Label -->

    <Label fx:id="messageLabel"
           layoutX="70.0"
           layoutY="155.0"
           prefWidth="700.0"
           textFill="red"/>



    <!-- Assigned Matches Table -->

    <TableView fx:id="assignedMatchesTable"
               layoutX="70.0"
               layoutY="190.0"
               prefHeight="330.0"
               prefWidth="760.0">

        <columns>

            <TableColumn fx:id="matchIdCol"
                         text="Match ID"
                         prefWidth="80"/>

            <TableColumn fx:id="homeTeamCol"
                         text="Home Team"
                         prefWidth="120"/>

            <TableColumn fx:id="awayTeamCol"
                         text="Away Team"
                         prefWidth="120"/>

            <TableColumn fx:id="competitionCol"
                         text="Competition"
                         prefWidth="110"/>

            <TableColumn fx:id="stadiumCol"
                         text="Stadium"
                         prefWidth="110"/>

            <TableColumn fx:id="dateCol"
                         text="Date"
                         prefWidth="90"/>

            <TableColumn fx:id="timeCol"
                         text="Time"
                         prefWidth="70"/>

            <TableColumn fx:id="statusCol"
                         text="Status"
                         prefWidth="90"/>

        </columns>

    </TableView>



    <!-- Back Button -->

    <Button layoutX="70.0"
            layoutY="540.0"
            prefWidth="120"
            text="Back"
            onAction="#backOA"/>


</AnchorPane>