<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="500.0"
            prefWidth="850.0"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.summer26.section1.group10.simulatingoperationsofbangladeshfootballfederation.turjo.controller.matchofficial_assignedmatchesController">


    <Text layoutX="260.0"
          layoutY="40.0"
          text="Assigned Matches">

        <font>
            <Font size="28"/>
        </font>

    </Text>



    <TableView fx:id="assignedMatchesTable"
               layoutX="50.0"
               layoutY="90.0"
               prefWidth="750.0"
               prefHeight="260.0">

        <columns>

            <TableColumn fx:id="matchCol"
                         text="Match"
                         prefWidth="200"/>

            <TableColumn fx:id="dateCol"
                         text="Date"
                         prefWidth="120"/>

            <TableColumn fx:id="timeCol"
                         text="Time"
                         prefWidth="100"/>

            <TableColumn fx:id="venueCol"
                         text="Venue"
                         prefWidth="150"/>

            <TableColumn fx:id="roleCol"
                         text="Role"
                         prefWidth="120"/>

        </columns>

    </TableView>



    <Button layoutX="220.0"
            layoutY="410.0"
            prefWidth="150"
            text="Refresh"
            onAction="#refreshOA"/>


    <Button layoutX="450.0"
            layoutY="410.0"
            prefWidth="150"
            text="Back"
            onAction="#backOA"/>


</AnchorPane>