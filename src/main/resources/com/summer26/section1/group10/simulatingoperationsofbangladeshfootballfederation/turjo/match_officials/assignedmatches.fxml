<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="650.0" prefWidth="1000.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.summer26.section1.group10.simulatingoperationsofbangladeshfootballfederation.turjo.controller.matchofficial_assignedmatchesController">

    <children>

        <Label layoutX="340.0"
               layoutY="20.0"
               style="-fx-font-size:24px; -fx-font-weight:bold;"
               text="Assigned Matches" />

        <VBox layoutX="20.0"
              layoutY="70.0"
              prefHeight="550.0"
              prefWidth="960.0"
              spacing="15.0">

            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>

            <TableView fx:id="assignedMatchesTable"
                       prefHeight="470.0"
                       prefWidth="930.0">

                <columns>

                    <TableColumn fx:id="matchIdCol"
                                 prefWidth="100.0"
                                 text="Match ID"/>

                    <TableColumn fx:id="homeTeamCol"
                                 prefWidth="150.0"
                                 text="Home Team"/>

                    <TableColumn fx:id="awayTeamCol"
                                 prefWidth="150.0"
                                 text="Away Team"/>

                    <TableColumn fx:id="dateCol"
                                 prefWidth="120.0"
                                 text="Match Date"/>

                    <TableColumn fx:id="timeCol"
                                 prefWidth="120.0"
                                 text="Match Time"/>

                    <TableColumn fx:id="venueCol"
                                 prefWidth="170.0"
                                 text="Venue"/>

                    <TableColumn fx:id="roleCol"
                                 prefWidth="120.0"
                                 text="Role"/>

                </columns>

            </TableView>

            <HBox spacing="20">

                <Button fx:id="refreshButton"
                        mnemonicParsing="false"
                        onAction="#refreshButtonOnAction"
                        prefWidth="120.0"
                        text="Refresh"/>

                <Button fx:id="backButton"
                        mnemonicParsing="false"
                        onAction="#backButtonOnAction"
                        prefWidth="120.0"
                        text="Back"/>

            </HBox>

        </VBox>

    </children>

</AnchorPane>