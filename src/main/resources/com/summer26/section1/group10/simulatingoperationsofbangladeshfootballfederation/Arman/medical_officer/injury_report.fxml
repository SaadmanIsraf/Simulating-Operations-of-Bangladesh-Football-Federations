<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="775.0" prefWidth="1017.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.summer26.section1.group10.simulatingoperationsofbangladeshfootballfederation.Arman.medical_officer_controller.injury_report_controller">

    <top>
        <HBox alignment="CENTER" prefHeight="60.0" style="-fx-background-color:#42AD60;">

            <children>
                <Label text="Injury Report &amp; Fitness Status" textFill="WHITE">
                    <font>
                        <Font name="Times New Roman Bold" size="20.0" />
                    </font>
                </Label>
            </children>

        </HBox>
    </top>

    <center>

        <AnchorPane style="-fx-background-color:#F5F5F5;">

            <children>

                <Label layoutX="25.0" layoutY="25.0" text="Search Player ID :">
                    <font>
                        <Font name="Times New Roman Bold" size="14.0" />
                    </font>
                </Label>

                <TextField fx:id="search_by_player_Id_textfield" layoutX="160.0" layoutY="20.0" prefWidth="170.0" />

                <Button layoutX="345.0" layoutY="20.0" mnemonicParsing="false" onAction="#search_by_player_Id_on_action" text="Search" />

                <TextArea fx:id="player_details_textarea" editable="false" layoutX="25.0" layoutY="60.0" prefHeight="300.0" prefWidth="420.0" promptText="Player information will appear here..." wrapText="true" />

                <Label layoutX="547.0" layoutY="25.0" text="Player ID :">
                    <font>
                        <Font name="Times New Roman Bold" size="14.0" />
                    </font>
                </Label>

                <TextField fx:id="player_id_text_field" layoutX="717.0" layoutY="20.0" prefWidth="200.0" />

                <Label layoutX="547.0" layoutY="70.0" text="Injury Type :">
                    <font>
                        <Font name="Times New Roman Bold" size="14.0" />
                    </font>
                </Label>

                <ComboBox fx:id="injury_type_combobox" layoutX="717.0" layoutY="65.0" onAction="#injury_type_combobox_on_action" prefWidth="200.0" />

                <Label layoutX="547.0" layoutY="115.0" text="Injury Date :">
                    <font>
                        <Font name="Times New Roman Bold" size="14.0" />
                    </font>
                </Label>

                <DatePicker fx:id="injury_date_datepicker" layoutX="717.0" layoutY="110.0" />

                <Label layoutX="547.0" layoutY="160.0" text="Affected Body Part :">
                    <font>
                        <Font name="Times New Roman Bold" size="14.0" />
                    </font>
                </Label>

                <ComboBox fx:id="affected_body_part_combobox" layoutX="717.0" layoutY="155.0" onAction="#affected_body_part_combobox_on_action" prefWidth="200.0" />

                <Label layoutX="547.0" layoutY="205.0" text="Severity :">
                    <font>
                        <Font name="Times New Roman Bold" size="14.0" />
                    </font>
                </Label>

                <ComboBox fx:id="severity_combobox" layoutX="717.0" layoutY="200.0" onAction="#Severity_combobox_on_action" prefWidth="200.0" />

                <Label layoutX="547.0" layoutY="250.0" text="Initial Fitness Status :">
                    <font>
                        <Font name="Times New Roman Bold" size="14.0" />
                    </font>
                </Label>

                <ComboBox fx:id="initial_fitness_status_combobox" layoutX="717.0" layoutY="245.0" onAction="#initial_fitness_status_combobox_on_action" prefWidth="200.0" />

                <Label layoutX="547.0" layoutY="295.0" text="Additional Notes :">
                    <font>
                        <Font name="Times New Roman Bold" size="14.0" />
                    </font>
                </Label>

                <TextArea fx:id="additional_notes_textfield" layoutX="717.0" layoutY="290.0" prefHeight="70.0" prefWidth="250.0" wrapText="true" />

                <Button layoutX="867.0" layoutY="372.0" mnemonicParsing="false" onAction="#save_button_on_action" prefWidth="100.0" text="Save" />

                <TableView fx:id="Injurt_report_tableview" layoutX="25.0" layoutY="412.0" prefHeight="250.0" prefWidth="950.0">

                    <columns>

                        <TableColumn fx:id="player_id_column" prefWidth="90.0" text="Player ID" />

                        <TableColumn fx:id="injury_type_column" prefWidth="140.0" text="Injury Type" />

                        <TableColumn fx:id="injury_date_column" prefWidth="120.0" text="Injury Date" />

                        <TableColumn fx:id="affected_body_part_column" prefWidth="160.0" text="Affected Body Part" />

                        <TableColumn fx:id="initial_fitness_status_column" prefWidth="130.0" text="Fitness Status" />

                        <TableColumn fx:id="severity_column" prefWidth="100.0" text="Severity" />

                        <TableColumn fx:id="additional_notes_column" prefWidth="210.0" text="Additional Notes" />

                    </columns>

                </TableView>

                <Button layoutX="25.0" layoutY="675.0" mnemonicParsing="false" onAction="#back_button_on_action" text="← Back" />

            </children>

        </AnchorPane>

    </center>

</BorderPane>
