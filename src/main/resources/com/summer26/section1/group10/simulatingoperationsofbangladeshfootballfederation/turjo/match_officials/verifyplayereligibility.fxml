<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="750.0"
            prefWidth="1100.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.summer26.section1.group10.simulatingoperationsofbangladeshfootballfederation.turjo.controller.matchofficial_submitmatchreportController">

    <children>

        <Label layoutX="400.0"
               layoutY="20.0"
               text="Submit Match Report"
               style="-fx-font-size:24px; -fx-font-weight:bold;" />

        <VBox layoutX="20.0"
              layoutY="60.0"
              prefWidth="330.0"
              spacing="10.0">

            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>

            <Label text="Match ID"/>
            <TextField fx:id="matchIdTF"
                       promptText="Enter Match ID"/>

            <Label text="Home Team"/>
            <TextField fx:id="homeTeamTF"
                       promptText="Enter Home Team"/>

            <Label text="Away Team"/>
            <TextField fx:id="awayTeamTF"
                       promptText="Enter Away Team"/>

            <Label text="Match Date"/>
            <DatePicker fx:id="matchDateDP"/>

            <Label text="Final Score"/>
            <TextField fx:id="scoreTF"
                       promptText="Example: 2-1"/>

            <Label text="Goal Scorers"/>
            <TextField fx:id="goalScorersTF"
                       promptText="Separate names with commas"/>

            <Label text="Yellow Cards"/>
            <TextField fx:id="yellowCardsTF"
                       promptText="Enter total yellow cards"/>

            <Label text="Red Cards"/>
            <TextField fx:id="redCardsTF"
                       promptText="Enter total red cards"/>

            <Label text="Match Status"/>
            <ComboBox fx:id="statusCB"
                      prefWidth="250.0"/>

            <Label text="Match Summary"/>
            <TextArea fx:id="summaryTA"
                      prefHeight="120.0"
                      wrapText="true"
                      promptText="Write match summary..."/>

            <HBox spacing="10">

                <Button text="Submit"
                        prefWidth="90.0"
                        onAction="#submitButtonOnAction"/>

                <Button text="Clear"
                        prefWidth="90.0"
                        onAction="#clearButtonOnAction"/>

                <Button text="Back"
                        prefWidth="90.0"
                        onAction="#backButtonOnAction"/>

            </HBox>

        </VBox>

        <TableView fx:id="matchReportTable"
                   layoutX="370.0"
                   layoutY="60.0"
                   prefHeight="650.0"
                   prefWidth="700.0">

            <columns>

                <TableColumn fx:id="matchIdCol"
                             text="Match ID"
                             prefWidth="90.0"/>

                <TableColumn fx:id="homeTeamCol"
                             text="Home Team"
                             prefWidth="110.0"/>

                <TableColumn fx:id="awayTeamCol"
                             text="Away Team"
                             prefWidth="110.0"/>

                <TableColumn fx:id="dateCol"
                             text="Date"
                             prefWidth="100.0"/>

                <TableColumn fx:id="scoreCol"
                             text="Score"
                             prefWidth="80.0"/>

                <TableColumn fx:id="yellowCardsCol"
                             text="Yellow"
                             prefWidth="80.0"/>

                <TableColumn fx:id="redCardsCol"
                             text="Red"
                             prefWidth="70.0"/>

                <TableColumn fx:id="statusCol"
                             text="Status"
                             prefWidth="120.0"/>

            </columns>

        </TableView>

    </children>

</AnchorPane>