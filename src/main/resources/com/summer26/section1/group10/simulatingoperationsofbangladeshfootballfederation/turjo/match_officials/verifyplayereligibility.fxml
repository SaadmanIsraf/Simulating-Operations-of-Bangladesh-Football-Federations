<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="600.0"
            prefWidth="1000.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.summer26.section1.group10.simulatingoperationsofbangladeshfootballfederation.turjo.controller.matchofficial_verifyplayereligibilityController">

    <children>

        <Label layoutX="330.0"
               layoutY="20.0"
               text="Verify Player Eligibility"
               style="-fx-font-size:24px; -fx-font-weight:bold;"/>

        <Label layoutX="30.0" layoutY="80.0" text="Player ID"/>
        <TextField fx:id="playerIdTF"
                   layoutX="150.0"
                   layoutY="75.0"
                   prefWidth="180.0"/>

        <Label layoutX="30.0" layoutY="120.0" text="Player Name"/>
        <TextField fx:id="playerNameTF"
                   layoutX="150.0"
                   layoutY="115.0"
                   prefWidth="180.0"/>

        <Label layoutX="30.0" layoutY="160.0" text="Team"/>
        <TextField fx:id="teamTF"
                   layoutX="150.0"
                   layoutY="155.0"
                   prefWidth="180.0"/>

        <Label layoutX="30.0" layoutY="200.0" text="Yellow Cards"/>
        <TextField fx:id="yellowCardTF"
                   layoutX="150.0"
                   layoutY="195.0"
                   prefWidth="180.0"/>

        <Label layoutX="30.0" layoutY="240.0" text="Red Cards"/>
        <TextField fx:id="redCardTF"
                   layoutX="150.0"
                   layoutY="235.0"
                   prefWidth="180.0"/>

        <Label layoutX="30.0" layoutY="280.0" text="Eligibility"/>
        <TextField fx:id="eligibilityTF"
                   layoutX="150.0"
                   layoutY="275.0"
                   prefWidth="180.0"
                   editable="false"/>

        <Button layoutX="20.0"
                layoutY="340.0"
                prefWidth="80.0"
                text="Add"
                onAction="#addButtonOnAction"/>

        <Button layoutX="110.0"
                layoutY="340.0"
                prefWidth="80.0"
                text="Verify"
                onAction="#verifyButtonOnAction"/>

        <Button layoutX="200.0"
                layoutY="340.0"
                prefWidth="80.0"
                text="Update"
                onAction="#updateButtonOnAction"/>

        <Button layoutX="290.0"
                layoutY="340.0"
                prefWidth="80.0"
                text="Delete"
                onAction="#deleteButtonOnAction"/>

        <Button layoutX="80.0"
                layoutY="390.0"
                prefWidth="120.0"
                text="Clear"
                onAction="#clearButtonOnAction"/>

        <Button layoutX="220.0"
                layoutY="390.0"
                prefWidth="120.0"
                text="Back"
                onAction="#backButtonOnAction"/>

        <TableView fx:id="playerTable"
                   layoutX="390.0"
                   layoutY="70.0"
                   prefWidth="590.0"
                   prefHeight="480.0"
                   onMouseClicked="#tableMouseClicked">

            <columns>

                <TableColumn fx:id="playerIdCol"
                             text="Player ID"
                             prefWidth="80.0"/>

                <TableColumn fx:id="playerNameCol"
                             text="Player Name"
                             prefWidth="130.0"/>

                <TableColumn fx:id="teamCol"
                             text="Team"
                             prefWidth="100.0"/>

                <TableColumn fx:id="yellowCardCol"
                             text="Yellow"
                             prefWidth="70.0"/>

                <TableColumn fx:id="redCardCol"
                             text="Red"
                             prefWidth="70.0"/>

                <TableColumn fx:id="eligibilityCol"
                             text="Eligibility"
                             prefWidth="120.0"/>

            </columns>

        </TableView>

    </children>

</AnchorPane>