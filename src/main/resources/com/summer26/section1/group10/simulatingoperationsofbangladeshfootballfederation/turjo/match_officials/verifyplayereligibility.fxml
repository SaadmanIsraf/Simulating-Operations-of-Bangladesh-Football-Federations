<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0"
            prefWidth="900.0"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.summer26.section1.group10.simulatingoperationsofbangladeshfootballfederation.turjo.controller.matchofficial_verifyplayereligibilityController">


    <Label layoutX="250.0"
           layoutY="30.0"
           text="Player Eligibility &amp; Card History"
           style="-fx-font-size:24px; -fx-font-weight:bold;">

        <font>
            <Font size="24"/>
        </font>

    </Label>



    <!-- Select Match -->

    <Label layoutX="80.0"
           layoutY="100.0"
           text="Select Match"/>

    <ComboBox fx:id="matchCB"
              layoutX="80.0"
              layoutY="125.0"
              prefWidth="250"
              promptText="Choose Match"/>



    <!-- Select Player -->

    <Label layoutX="450.0"
           layoutY="100.0"
           text="Select Player"/>

    <ComboBox fx:id="playerCB"
              layoutX="450.0"
              layoutY="125.0"
              prefWidth="250"
              promptText="Choose Player"/>




    <!-- Player Information Table -->

    <TableView fx:id="playerTable"
               layoutX="80.0"
               layoutY="220.0"
               prefWidth="740"
               prefHeight="220">

        <columns>

            <TableColumn fx:id="playerNameCol"
                         text="Player Name"
                         prefWidth="220"/>

            <TableColumn fx:id="eligibilityCol"
                         text="Eligibility Status"
                         prefWidth="180"/>

            <TableColumn fx:id="yellowCardCol"
                         text="Yellow Cards"
                         prefWidth="150"/>

            <TableColumn fx:id="redCardCol"
                         text="Red Cards"
                         prefWidth="150"/>

        </columns>

    </TableView>




    <!-- Buttons -->

    <Button layoutX="150.0"
            layoutY="500.0"
            prefWidth="160"
            text="Check Eligibility"
            onAction="#checkEligibilityOA"/>


    <Button layoutX="370.0"
            layoutY="500.0"
            prefWidth="160"
            text="View Cards"
            onAction="#viewCardsOA"/>


    <Button layoutX="590.0"
            layoutY="500.0"
            prefWidth="120"
            text="Back"
            onAction="#backOA"/>


</AnchorPane>