<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="650.0"
            prefWidth="1000.0"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.summer26.section1.group10.simulatingoperationsofbangladeshfootballfederation.turjo.controller.federation_administrator_publishannouncementController">


    <!-- Title -->

    <Label layoutX="330.0"
           layoutY="25.0"
           text="Publish Match Announcement"
           textFill="#133799">

        <font>
            <Font size="26"/>
        </font>

    </Label>


    <!-- Announcement Title -->

    <Label layoutX="60.0"
           layoutY="100.0"
           text="Announcement Title"/>

    <TextField fx:id="txtAnnouncementTitle"
               layoutX="60.0"
               layoutY="125.0"
               prefWidth="220"
               promptText="Enter announcement title"/>



    <!-- Match -->

    <Label layoutX="330.0"
           layoutY="100.0"
           text="Match"/>

    <ComboBox fx:id="cmbMatch"
              layoutX="330.0"
              layoutY="125.0"
              prefWidth="220"
              promptText="Select Match"/>



    <!-- Competition -->

    <Label layoutX="600.0"
           layoutY="100.0"
           text="Competition"/>

    <ComboBox fx:id="cmbCompetition"
              layoutX="600.0"
              layoutY="125.0"
              prefWidth="220"
              promptText="Select Competition"/>



    <!-- Venue -->

    <Label layoutX="60.0"
           layoutY="210.0"
           text="Venue"/>

    <TextField fx:id="txtVenue"
               layoutX="60.0"
               layoutY="235.0"
               prefWidth="220"
               promptText="Stadium/Venue"/>



    <!-- Sponsor -->

    <Label layoutX="330.0"
           layoutY="210.0"
           text="Sponsor"/>

    <TextField fx:id="txtSponsor"
               layoutX="330.0"
               layoutY="235.0"
               prefWidth="220"
               promptText="Main Sponsor"/>



    <!-- Place -->

    <Label layoutX="600.0"
           layoutY="210.0"
           text="Place/Location"/>

    <TextField fx:id="txtPlace"
               layoutX="600.0"
               layoutY="235.0"
               prefWidth="220"
               promptText="Match Location"/>



    <!-- Date -->

    <Label layoutX="60.0"
           layoutY="320.0"
           text="Match Date"/>

    <DatePicker fx:id="dpMatchDate"
                layoutX="60.0"
                layoutY="345.0"
                prefWidth="220"/>



    <!-- Time -->

    <Label layoutX="330.0"
           layoutY="320.0"
           text="Match Time"/>

    <TextField fx:id="txtMatchTime"
               layoutX="330.0"
               layoutY="345.0"
               prefWidth="220"
               promptText="HH:mm"/>



    <!-- Match Type -->

    <Label layoutX="600.0"
           layoutY="320.0"
           text="Match Type"/>

    <ComboBox fx:id="cmbMatchType"
              layoutX="600.0"
              layoutY="345.0"
              prefWidth="220"
              promptText="Friendly/League/Final"/>



    <!-- Announcement Details -->

    <Label layoutX="60.0"
           layoutY="430.0"
           text="Announcement Message"/>

    <TextArea fx:id="txtAnnouncementDetails"
              layoutX="60.0"
              layoutY="455.0"
              prefWidth="760"
              prefHeight="90"
              promptText="Write announcement details here..."/>



    <!-- Buttons -->

    <Button layoutX="150.0"
            layoutY="580.0"
            prefWidth="120"
            text="Publish"
            onAction="#publishAnnouncementOA"/>


    <Button layoutX="320.0"
            layoutY="580.0"
            prefWidth="120"
            text="Update"
            onAction="#updateAnnouncementOA"/>


    <Button layoutX="490.0"
            layoutY="580.0"
            prefWidth="120"
            text="Clear"
            onAction="#clearOA"/>


    <Button layoutX="660.0"
            layoutY="580.0"
            prefWidth="120"
            text="Back"
            onAction="#backOA"/>


</AnchorPane>