<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.summer26.section1.group10.simulatingoperationsofbangladeshfootballfederation.Ruba.MatchController">
   <center>
        <AnchorPane prefHeight="510.0" prefWidth="800.0" style="-fx-background-color: E6E8AC;" BorderPane.alignment="CENTER">
            <children>
                <Label layoutX="44.0" layoutY="107.0" text="Tournament :">
                    <font>
                        <Font name="Times New Roman Bold" size="14.0" />
                    </font>
                </Label>
                <ComboBox fx:id="tournamentComboBox" layoutX="145.0" layoutY="102.0" prefWidth="180.0" promptText="Select Tournament" />
                <Label layoutX="478.0" layoutY="107.0" text="Match :">
                    <font>
                        <Font name="Times New Roman Bold" size="14.0" />
                    </font>
                </Label>
                <ComboBox fx:id="matchComboBox" layoutX="540.0" layoutY="102.0" prefWidth="220.0" promptText="Select Match" />
                <Button layoutX="145.0" layoutY="150.0" mnemonicParsing="false" onAction="#viewSchedule" text="View Schedule" />
                <Button layoutX="319.0" layoutY="150.0" mnemonicParsing="false" onAction="#viewScore" text="View Score" />
                <Button layoutX="478.0" layoutY="150.0" mnemonicParsing="false" onAction="#viewVenue" text="View Venue" />
                <TableView fx:id="matchTable" layoutX="40.0" layoutY="194.0" prefHeight="250.0" prefWidth="702.0">
                    <columns>
                        <TableColumn fx:id="matchColumn" prefWidth="170.0" text="Match" />
                        <TableColumn fx:id="dateColumn" prefWidth="120.0" text="Date" />
                        <TableColumn fx:id="timeColumn" prefWidth="100.0" text="Time" />
                        <TableColumn fx:id="venueColumn" prefWidth="180.0" text="Venue" />
                        <TableColumn fx:id="scoreColumn" prefWidth="130.0" text="Score" />
                    </columns>
                </TableView>
                <Label layoutX="40.0" layoutY="453.0" text="Status :">
                    <font>
                        <Font name="Times New Roman Bold" size="14.0" />
                    </font>
                </Label>
                <Label fx:id="match_details_label" layoutX="90.0" layoutY="452.0" prefWidth="620.0" text="Select an option to view match information." />
                <Button layoutX="40.0" layoutY="500.0" mnemonicParsing="false" onAction="#backBtnOnAction" text="Back" />
            <Label layoutX="286.0" prefHeight="62.0" prefWidth="437.0" text="Match Information">
               <font>
                  <Font size="30.0" />
               </font>
            </Label>
            </children>
        </AnchorPane>
   </center>
</BorderPane>
