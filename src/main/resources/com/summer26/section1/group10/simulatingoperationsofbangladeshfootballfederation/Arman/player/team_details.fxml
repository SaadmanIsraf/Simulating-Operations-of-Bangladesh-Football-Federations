<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="720.0"
            prefWidth="920.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.summer26.section1.group10.simulatingoperationsofbangladeshfootballfederation.Arman.player_controller.team_details_controller">

    <top>
        <HBox alignment="CENTER"
              prefHeight="82.0"
              style="-fx-background-color: #42AD60;"
              BorderPane.alignment="CENTER">

            <Label text="Team Details"
                   textFill="WHITE">

                <font>
                    <Font name="Times New Roman Bold"
                          size="21.0"/>
                </font>

            </Label>

        </HBox>
    </top>

    <center>
        <VBox alignment="TOP_CENTER"
              spacing="16.0"
              style="-fx-background-color: #F4F7F5;">

            <padding>
                <Insets top="22.0"
                        right="38.0"
                        bottom="22.0"
                        left="38.0"/>
            </padding>

            <Label text="View Team Information"
                   textFill="#2F5638">

                <font>
                    <Font name="Times New Roman Bold"
                          size="18.0"/>
                </font>

            </Label>

            <!-- Team search section -->
            <VBox maxWidth="820.0"
                  spacing="12.0"
                  style="-fx-background-color: WHITE;
                         -fx-background-radius: 10;
                         -fx-border-color: #D5E3D8;
                         -fx-border-radius: 10;">

                <padding>
                    <Insets top="18.0"
                            right="22.0"
                            bottom="18.0"
                            left="22.0"/>
                </padding>

                <Label text="Select a Team"
                       textFill="#2F5638">

                    <font>
                        <Font name="Times New Roman Bold"
                              size="16.0"/>
                    </font>

                </Label>

                <HBox alignment="CENTER"
                      spacing="15.0">

                    <Label text="Team Name:">

                        <font>
                            <Font name="Times New Roman Bold"
                                  size="14.0"/>
                        </font>

                    </Label>

                    <ComboBox fx:id="team_name_combobox"
                              onAction="#team_name_combobox_on_action"
                              prefWidth="340.0"
                              promptText="Choose a team"/>

                    <Button mnemonicParsing="false"
                            onAction="#search_button_on_action"
                            prefWidth="110.0"
                            style="-fx-background-color: #2F7D45;
                                   -fx-text-fill: white;
                                   -fx-font-weight: bold;"
                            text="Search"/>

                </HBox>

            </VBox>

            <!-- Team summary section -->
            <VBox maxWidth="820.0"
                  spacing="14.0"
                  style="-fx-background-color: WHITE;
                         -fx-background-radius: 10;
                         -fx-border-color: #D5E3D8;
                         -fx-border-radius: 10;">

                <padding>
                    <Insets top="18.0"
                            right="24.0"
                            bottom="18.0"
                            left="24.0"/>
                </padding>

                <Label text="Selected Team Information"
                       textFill="#2F5638">

                    <font>
                        <Font name="Times New Roman Bold"
                              size="16.0"/>
                    </font>

                </Label>

                <GridPane hgap="18.0"
                          vgap="14.0">

                    <columnConstraints>
                        <ColumnConstraints minWidth="150.0"
                                           prefWidth="170.0"/>

                        <ColumnConstraints minWidth="230.0"
                                           prefWidth="260.0"/>

                        <ColumnConstraints minWidth="135.0"
                                           prefWidth="150.0"/>

                        <ColumnConstraints minWidth="180.0"
                                           prefWidth="210.0"/>
                    </columnConstraints>

                    <Label text="Team Name:"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="0">

                        <font>
                            <Font name="Times New Roman Bold"
                                  size="14.0"/>
                        </font>

                    </Label>

                    <Label fx:id="team_name_label"
                           text="Not selected"
                           textFill="#33483A"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="0"/>

                    <Label text="Total Members:"
                           GridPane.columnIndex="2"
                           GridPane.rowIndex="0">

                        <font>
                            <Font name="Times New Roman Bold"
                                  size="14.0"/>
                        </font>

                    </Label>

                    <Label fx:id="total_members_label"
                           text="0"
                           textFill="#33483A"
                           GridPane.columnIndex="3"
                           GridPane.rowIndex="0"/>

                    <Label text="Captain:"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="1">

                        <font>
                            <Font name="Times New Roman Bold"
                                  size="14.0"/>
                        </font>

                    </Label>

                    <Label fx:id="captain_name_label"
                           text="Not available"
                           textFill="#33483A"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="1"/>

                    <Label text="Coach:"
                           GridPane.columnIndex="2"
                           GridPane.rowIndex="1">

                        <font>
                            <Font name="Times New Roman Bold"
                                  size="14.0"/>
                        </font>

                    </Label>

                    <Label fx:id="coach_name_label"
                           text="Not available"
                           textFill="#33483A"
                           GridPane.columnIndex="3"
                           GridPane.rowIndex="1"/>

                </GridPane>

            </VBox>

            <!-- Team members section -->
            <VBox maxWidth="820.0"
                  spacing="8.0">

                <Label text="Team Members"
                       textFill="#2F5638">

                    <font>
                        <Font name="Times New Roman Bold"
                              size="15.0"/>
                    </font>

                </Label>

                <ListView fx:id="team_members_listview"
                          prefHeight="175.0"
                          prefWidth="820.0"/>

                <Label fx:id="team_members_information_label"
                       alignment="CENTER"
                       prefWidth="820.0"
                       text="Select a team to view its members."
                       textFill="#657269"/>

            </VBox>

            <!-- Team description section -->
            <VBox maxWidth="820.0"
                  spacing="8.0">

                <Label text="Team Description"
                       textFill="#2F5638">

                    <font>
                        <Font name="Times New Roman Bold"
                              size="15.0"/>
                    </font>

                </Label>

                <TextArea fx:id="team_description_textarea"
                          editable="false"
                          prefHeight="115.0"
                          prefWidth="820.0"
                          promptText="Team description will appear here."
                          wrapText="true"/>

            </VBox>

            <!-- Back button -->
            <HBox alignment="CENTER"
                  maxWidth="820.0">

                <Button mnemonicParsing="false"
                        onAction="#back_button_on_action"
                        prefWidth="105.0"
                        text="← Back"/>

                <Region HBox.hgrow="ALWAYS"/>

            </HBox>

        </VBox>
    </center>

</BorderPane>