<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="516.0"
            prefWidth="659.0"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.summer26.section1.group10.simulatingoperationsofbangladeshfootballfederation.Arman.player_controller.team_details_controller">

    <top>
        <HBox alignment="CENTER"
              prefHeight="81.0"
              style="-fx-background-color: #42AD60;"
              BorderPane.alignment="CENTER">

            <Label text="Team Details"
                   textFill="WHITE">

                <font>
                    <Font name="Times New Roman Bold" size="20.0"/>
                </font>

            </Label>
        </HBox>
    </top>

    <center>
        <VBox alignment="TOP_CENTER"
              spacing="14.0"
              style="-fx-background-color: #F4F7F5;">

            <padding>
                <Insets bottom="20.0"
                        left="35.0"
                        right="35.0"
                        top="20.0"/>
            </padding>

            <Label text="My Team Information"
                   textFill="#2F5638">

                <font>
                    <Font name="Times New Roman Bold" size="17.0"/>
                </font>

            </Label>

            <GridPane alignment="CENTER"
                      hgap="20.0"
                      vgap="12.0">

                <Label text="Team Name:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="0">

                    <font>
                        <Font name="Times New Roman Bold" size="14.0"/>
                    </font>
                </Label>

                <Label fx:id="team_name_label"
                       prefWidth="300.0"
                       style="-fx-background-color: white;
                              -fx-border-color: #B7C9BC;
                              -fx-padding: 7;"
                       text="Team Name"
                       GridPane.columnIndex="1"
                       GridPane.rowIndex="0"/>

                <Label text="Captain:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="1">

                    <font>
                        <Font name="Times New Roman Bold" size="14.0"/>
                    </font>
                </Label>

                <Label fx:id="captain_name_label"
                       prefWidth="300.0"
                       style="-fx-background-color: white;
                              -fx-border-color: #B7C9BC;
                              -fx-padding: 7;"
                       text="Captain Name"
                       GridPane.columnIndex="1"
                       GridPane.rowIndex="1"/>

                <Label text="Coach:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="2">

                    <font>
                        <Font name="Times New Roman Bold" size="14.0"/>
                    </font>
                </Label>

                <Label fx:id="coach_name_label"
                       prefWidth="300.0"
                       style="-fx-background-color: white;
                              -fx-border-color: #B7C9BC;
                              -fx-padding: 7;"
                       text="Coach Name"
                       GridPane.columnIndex="1"
                       GridPane.rowIndex="2"/>

            </GridPane>

            <Label text="Team Members"
                   textFill="#2F5638">

                <font>
                    <Font name="Times New Roman Bold" size="14.0"/>
                </font>
            </Label>

            <ListView fx:id="team_members_listview"
                      prefHeight="120.0"
                      prefWidth="430.0"/>

            <Label text="Team Description"
                   textFill="#2F5638">

                <font>
                    <Font name="Times New Roman Bold" size="14.0"/>
                </font>
            </Label>

            <TextArea fx:id="team_description_textarea"
                      editable="false"
                      prefHeight="80.0"
                      prefWidth="430.0"
                      wrapText="true"/>

            <Label fx:id="information_label"
                   alignment="CENTER"
                   prefWidth="500.0"
                   textFill="#C0392B">

                <font>
                    <Font name="Times New Roman Bold" size="13.0"/>
                </font>
            </Label>

            <HBox alignment="CENTER"
                  spacing="350.0">

                <Button mnemonicParsing="false"
                        onAction="#back_button_on_action"
                        prefWidth="90.0"
                        text="← Back"/>

                <Button mnemonicParsing="false"
                        onAction="#refresh_button_on_action"
                        prefWidth="100.0"
                        style="-fx-background-color: #42AD60;
                               -fx-text-fill: white;
                               -fx-font-weight: bold;"
                        text="Refresh"/>

            </HBox>

        </VBox>
    </center>

</BorderPane>