<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="500.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.summer26.section1.group10.simulatingoperationsofbangladeshfootballfederation.turjo.controller.federation_administrator_manageuseraccountController">


    <Label layoutX="280.0" layoutY="30.0" style="-fx-font-size:24px; -fx-font-weight:bold;" text="Manage User Account" textFill="#100bae" />


    <Label layoutX="80.0" layoutY="100.0" text="Username" />

    <TextField fx:id="usernameTF" layoutX="80.0" layoutY="125.0" prefWidth="220" />


    <Label layoutX="400.0" layoutY="100.0" text="Role" />

    <ComboBox fx:id="roleCB" layoutX="400.0" layoutY="125.0" prefWidth="220" promptText="Select Role" />



    <Label layoutX="80.0" layoutY="200.0" text="Account Status" />

    <ComboBox fx:id="statusCB" layoutX="80.0" layoutY="225.0" prefWidth="220" promptText="Active / Blocked" />



    <Label layoutX="400.0" layoutY="200.0" text="Permission" />

    <ComboBox fx:id="permissionCB" layoutX="400.0" layoutY="225.0" prefWidth="220" promptText="Admin / User" />



    <Button layoutX="120.0" layoutY="350.0" onAction="#updateUserOA" prefWidth="120" text="Update" />


    <Button layoutX="280.0" layoutY="350.0" onAction="#blockUserOA" prefWidth="120" text="Block" />


    <Button layoutX="440.0" layoutY="350.0" onAction="#activateUserOA" prefWidth="120" text="Activate" />


    <Button layoutX="600.0" layoutY="350.0" onAction="#backOA" prefWidth="100" text="Back" />


</AnchorPane>
