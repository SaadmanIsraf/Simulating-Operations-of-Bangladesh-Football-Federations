<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="650.0"
            prefWidth="1000.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.summer26.section1.group10.simulatingoperationsofbangladeshfootballfederation.turjo.controller.federation_manageuseraccountController">

    <children>

        <Label layoutX="380.0"
               layoutY="20.0"
               text="Manage User Accounts"
               style="-fx-font-size:24px; -fx-font-weight:bold;"/>

        <VBox layoutX="20.0"
              layoutY="70.0"
              prefWidth="300.0"
              spacing="12">

            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>

            <Label text="Username"/>
            <TextField fx:id="usernameTF"
                       promptText="Enter Username"/>

            <Label text="Role"/>
            <ComboBox fx:id="roleCB"
                      prefWidth="250"/>

            <Label text="Status"/>
            <ComboBox fx:id="statusCB"
                      prefWidth="250"/>

            <HBox spacing="10">

                <Button text="Add User"
                        prefWidth="90"
                        onAction="#addButtonOnAction"/>

                <Button text="Update"
                        prefWidth="90"
                        onAction="#updateButtonOnAction"/>

            </HBox>

            <HBox spacing="10">

                <Button text="Clear"
                        prefWidth="90"
                        onAction="#clearButtonOnAction"/>

                <Button text="Back"
                        prefWidth="90"
                        onAction="#backButtonOnAction"/>

            </HBox>

        </VBox>

        <TableView fx:id="userTable"
                   layoutX="340.0"
                   layoutY="70.0"
                   prefHeight="540.0"
                   prefWidth="620.0">

            <columns>

                <TableColumn fx:id="usernameCol"
                             text="Username"
                             prefWidth="220"/>

                <TableColumn fx:id="roleCol"
                             text="Role"
                             prefWidth="220"/>

                <TableColumn fx:id="statusCol"
                             text="Status"
                             prefWidth="180"/>

            </columns>

        </TableView>

    </children>

</AnchorPane>